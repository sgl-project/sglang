  "protocol": {
    "partition_context": "Every active owner retains the accepted token ledger and local KV prefix. Only the aux owner accesses token/position/mask/teacher tensors; only KV owners enqueue selected-layer exports.",
    "sequence_agreement": "PreparedSnapshotPartition.token_ids_sha256 hashes the int32 accepted token sequence. All owner digests must equal the aux token descriptor SHA-256; equal sequence lengths alone are insufficient.",
    "aux_integrity": "Context preparation supplies its committed ledger explicitly and rejects a mutated aux token buffer.",
    "cancellation": "abort invalidates collecting or sealed contexts. Snapshot/partition preparation rechecks state after copy waits and descriptor construction.",
    "buffer_lifetime": "Completion events and bounded KV staging remain owned by the request. Sealing flushes a partial staging tail; preparation never extends a Host slot lease.",
    "schema": "Public Manifest unchanged. The internal prepared partition record requires token_ids_sha256; KV-only preparation callers must supply token_ids."
  },
  "verification": {
    "cpu_trace": "TP4/PP2 with canonical KV owners on stage 0 and an aux-only owner on stage 1; chunked prefill, decode and accepted verify prefixes.",
    "source_reuse": "Noncontiguous source slots are overwritten immediately after export enqueue. Reconstructed KV tensors must match the original source values exactly.",
    "speculative_tail": "Lookahead KV and teacher rows beyond the terminal accepted prefix are trimmed. Batched staging includes a non-full tail.",
    "cuda_trace": "Canonical TP rank 2's KV-only request context copies through bounded staging, immediately reuses source slots, finalizes outside the forward stream, and waits before checking exact Host values.",
    "real_store": "Shared fixture now builds synthetic partitions through RequestCaptureContext. Independent owner processes register and publish their own payloads to a real TCP Mooncake Store; readback occurs after owner exit.",
    "runtime": "Single H100, Qwen3-0.6B, real TCP Store, HTTP Catalog test double, AR/static DSpark, graph/overlap modes, KV memory pressure, cache eviction and retract/resume. Synthetic draft checkpoints are used.",
    "catalog_fixture": "Zero/partial HTTP bodies followed by a socket half-close must leave no operation/error and must not poison the next producer. Complete invalid JSON still returns 409 and records the error."
  },
  "limits": [
    "Distributed serving gates remain closed. Cross-rank admission, accepted-token transport, failure propagation, descriptor/receipt exchange and TP/PP scheduler integration are still required.",
    "Trusted owner ledgers and matching digests do not prove arbitrary KV bytes were computed from the stated sequence.",
    "Cancellation cannot revoke already prepared descriptors, completed Store writes or published samples. The coordinator must discard pending work and enforce Catalog fencing.",
    "Synthetic partition traces and one-H100 inference do not validate multi-GPU target execution, RDMA, PD, production Catalog retention or trained draft quality."
  ],
  "next_integration": {
    "ordering": "PP stages receive upstream proxy tensors before entering forward; upstream sends proxy only after forward. An all-PP collective in before_forward would deadlock.",
    "admission": "Prepare multi-owner lease/Host-slot cohorts in a separate background control group, then carry the selected cohort ID through request propagation.",
    "nonblocking": "Missing capacity or control failure must disable/drop capture without blocking inference; use a communication sequence separate from inference groups."
  },
