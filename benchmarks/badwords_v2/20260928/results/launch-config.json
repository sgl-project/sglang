{
  "command_template": [
    "python",
    "-m",
    "sglang.launch_server",
    "--model-path",
    "${MODEL_DIR}/Qwen3-4B",
    "--served-model-name",
    "bad-words-test",
    "--host",
    "127.0.0.1",
    "--port",
    "31082",
    "--enable-custom-logit-processor",
    "--attention-backend",
    "fa3",
    "--mem-fraction-static",
    "0.4",
    "--context-length",
    "4096",
    "--trust-remote-code",
    "--max-running-requests",
    "32",
    "--cuda-graph-backend-decode",
    "full",
    "--cuda-graph-backend-prefill",
    "disabled",
    "--cuda-graph-bs-decode",
    "1",
    "2",
    "4",
    "8",
    "16",
    "24",
    "32",
    "--chunked-prefill-size",
    "512",
    "--random-seed",
    "42",
    "--disable-radix-cache",
    "--decode-log-interval",
    "100",
    "--speculative-algorithm",
    "DFLASH",
    "--speculative-draft-model-path",
    "${MODEL_DIR}/Qwen3-4B-DFlash-b16"
  ],
  "env": {
    "CUDA_VISIBLE_DEVICES": "0",
    "SGLANG_BAD_WORDS_BACKEND": "cuda",
    "SGLANG_BAD_WORDS_KEEP_SYNC": "0",
    "PYTHONPATH": "${SOURCE_DIR}/python"
  },
  "regular_decode": "Remove --speculative-algorithm DFLASH and --speculative-draft-model-path arguments."
}
