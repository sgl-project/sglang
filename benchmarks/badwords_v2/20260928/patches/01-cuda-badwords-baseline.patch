+        expected[0, 2] = expected[0, 4] = expected[1, 7] = -float("inf")
+        actual = BadWordsLogitsProcessor()(
+            logits,
+            [params([[1, 2], [1, 2], [2], [4]], [1]), params([[7]])],
+        )
+        self.assertIs(actual, logits)
