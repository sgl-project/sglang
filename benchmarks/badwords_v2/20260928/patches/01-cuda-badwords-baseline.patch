+def has_bad_words_processor(sampling_info):
+    """Inspect processor objects without reading GPU batch masks."""
+    return sampling_info is not None and any(
+        isinstance(processor, BadWordsLogitsProcessor)
+        for processor, _ in (sampling_info.custom_logit_processor or {}).values()
