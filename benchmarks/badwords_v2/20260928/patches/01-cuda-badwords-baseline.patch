+def encode_bad_words(bad_words, tokenizer):
+    """Encode both word-start forms using vLLM's prefix-space policy.
+
+    Reference: vLLM 1668e5976db7457631b84a6a570c64319581b1e7,
+    SamplingParams.update_from_tokenizer.
+    """
+    if not isinstance(bad_words, list) or any(
+        not isinstance(word, str) or not word for word in bad_words
+    ):
+        raise ValueError("bad_words must be a list of non-empty strings.")
+    if not bad_words:
+        return []
+    if tokenizer is None:
+        raise ValueError("bad_words requires an initialized tokenizer.")
+    # The tokenizer configuration is fixed for a serving process. Keep cache
+    # ownership local to that tokenizer and bound both entries and key length.
+    cache = getattr(tokenizer, "_sglang_bad_words_cache", None)
+    if cache is None:
+        cache = OrderedDict()
+        tokenizer._sglang_bad_words_cache = cache
+    normalized = list(dict.fromkeys(word.lstrip() for word in bad_words))
+    resolved = {}
+    missing = []
+    for word in normalized:
+        value = cache.get(word)
+        if value is None:
+            missing.append(word)
+        else:
+            cache.move_to_end(word)
+            resolved[word] = value
+    if missing:
+        texts = [form for word in missing for form in (word, " " + word)]
+        if hasattr(tokenizer, "batch_encode_plus"):
+            encoded = tokenizer.batch_encode_plus(
+                texts,
+                add_special_tokens=False,
+                return_attention_mask=False,
+                return_token_type_ids=False,
+            )["input_ids"]
+        else:
+            encoded = [
+                tokenizer.encode(text, add_special_tokens=False) for text in texts
+            ]
+        for word, plain, spaced in zip(missing, encoded[::2], encoded[1::2]):
+            if not plain:
+                raise ValueError(
+                    "bad_words entries must tokenize to at least one token."
+                )
+            forms = [tuple(plain)]
+            if spaced and spaced[0] != plain[0] and len(spaced) == len(plain):
+                forms.append(tuple(spaced))
+            value = tuple(forms)
+            resolved[word] = value
+            if len(word) <= 1024:
+                cache[word] = value
+                while len(cache) > 1024:
+                    cache.popitem(last=False)
+    sequences = [ids for word in normalized for ids in resolved[word]]
+    # Preserve order; repeated words should not add per-token work.
+    return [list(ids) for ids in dict.fromkeys(tuple(ids) for ids in sequences)]
+
+
+def prepare_bad_words_request(
+    sampling_params, tokenizer, serialized_processor, *, bad_words, enabled
+):
+    """Turn the string API into the same internal token-ID processor contract."""
+    if bad_words is None:
+        return serialized_processor
+    params = sampling_params.custom_params or {}
+    if "bad_words_token_ids" in params:
+        raise ValueError("Pass either bad_words or bad_words_token_ids, not both.")
+    if serialized_processor:
+        raise ValueError("bad_words cannot be combined with custom_logit_processor.")
+    if bad_words and not enabled:
+        raise ValueError("bad_words requires --enable-custom-logit-processor.")
+    sequences = encode_bad_words(bad_words, tokenizer)
+    if not sequences:
+        return None
+    sampling_params.custom_params = {**params, "bad_words_token_ids": sequences}
+    return BadWordsLogitsProcessor.to_str()
+
+
+def validate_bad_words_request(
+    serialized_processor,
+    sampling_params,
+    vocab_size,
+    *,
+    enabled,
+    speculative_algorithm,
+    disable_overlap_schedule,
+):
+    """Validate the opt-in processor before scheduling."""
+    if not serialized_processor or not enabled:
+        return
+    processor = CustomLogitProcessor.from_str(serialized_processor)
+    if not isinstance(processor, BadWordsLogitsProcessor):
+        return
+    if speculative_algorithm and speculative_algorithm != "DFLASH":
+        raise ValueError(
+            "BadWordsLogitsProcessor supports speculative decoding only with DFLASH."
+        )
+    if (
+        speculative_algorithm == "DFLASH"
+        and int(os.environ.get("SGLANG_SIMULATE_ACC_LEN", "0")) > 0
+    ):
+        raise ValueError(
+            "bad_words cannot be used with simulated speculative acceptance."
+        )
+    params = sampling_params.custom_params
+    words = params.get("bad_words_token_ids") if isinstance(params, dict) else None
+    if not isinstance(words, list):
+        raise ValueError(
+            "bad_words_token_ids must be a list of non-empty token ID lists."
+        )
+    for sequence in words:
+        if not isinstance(sequence, list) or not sequence:
+            raise ValueError(
+                "Each bad_words_token_ids sequence must be a non-empty list."
+            )
+        if any(
+            type(token) is not int or not 0 <= token < vocab_size for token in sequence
+        ):
+            raise ValueError(
+                "bad_words_token_ids must contain integer IDs within the vocabulary."
+            )
+    if _BAD_WORDS_BACKEND == "cuda":
+        if (
+            len(words) > 1024
+            or sum(map(len, words)) > 16384
+            or any(len(word) > 257 for word in words)
+        ):
+            raise ValueError(
+                "CUDA bad_words exceeds limits: 1024 sequences, "
+                "16384 total tokens, 257 tokens per sequence"
+            )
+    # Conservatively reserve one token this processor can never mask.
+    if len({sequence[-1] for sequence in words}) >= vocab_size:
+        raise ValueError("bad_words_token_ids may mask the entire vocabulary.")
+    # Additional hard masks require a request-level all-masked recovery path.
+    if any(
+        getattr(sampling_params, name, None)
+        for name in (
+            "json_schema",
+            "regex",
+            "ebnf",
+            "structural_tag",
+            "logit_bias",
+            "min_new_tokens",
+        )
+    ) or (params and "thinking_budget" in params):
+        raise ValueError(
+            "BadWordsLogitsProcessor does not yet support other hard sampling constraints."
+        )
