+    info = Info()
+    monkeypatch.setattr(device_module, "_BAD_WORDS_BACKEND", "cuda")
+    logits = torch.zeros(4, 32, device="cuda")
+    draft = torch.tensor([[9, 1, 2, 4]], device="cuda")
