+class BadWordsLogitsProcessor(CustomLogitProcessor):
+    """Block token sequences in generated output, excluding the prompt.
+
+    Pass bad_words_token_ids (list of non-empty lists) through custom_params.
+    Overlap scheduling synchronizes committed CPU history before this processor.
+    DFLASH supplies a separate effective history for each verification position.
+    """
+
+    @staticmethod
+    def _compiled(params):
+        # Cache on the request, not the processor shared by unrelated requests.
+        # Sampling parameters are immutable for a request's lifetime.
+        req = params["__req__"]
+        words = params["bad_words_token_ids"]
+        cached = getattr(req, "_bad_words_prefix_index", None)
+        if cached is None or cached[0] is not words:
+            by_length = {}
+            for word in words:
+                prefix = tuple(word[:-1])
+                by_length.setdefault(len(prefix), {}).setdefault(prefix, set()).add(
+                    word[-1]
+                )
+            index = tuple(
+                (length, prefixes) for length, prefixes in sorted(by_length.items())
+            )
+            cached = (words, index, max(by_length, default=0))
+            req._bad_words_prefix_index = cached
+        return cached[1], cached[2]
+
+    @staticmethod
+    def _collect(index, history, row, rows, tokens):
+        matched = None
+        for length, prefixes in index:
+            if length > len(history):
+                break
+            suffix = tuple(history[-length:]) if length else ()
+            banned = prefixes.get(suffix)
+            if banned:
+                matched = banned if matched is None else matched | banned
+        if matched:
+            # Different matching prefixes can exclude the same final token.
+            # Give index_put unique coordinates, even though all values are -inf.
+            rows.extend([row] * len(matched))
+            tokens.extend(matched)
+
+    @staticmethod
+    def _mask(logits, rows, tokens):
+        if rows:
+            # One small transfer and one sparse update; never gather full logits.
+            coordinates = torch.tensor(
+                [rows, tokens], dtype=torch.long, device=logits.device
+            )
+            logits[coordinates[0], coordinates[1]] = -float("inf")
+        return logits
+
+    @staticmethod
+    def _apply_rust_batch(
+        logits, custom_params, batch_indices, width, draft_rows, *, parallel
+    ):
+        matcher_type, match_batch = _rust_bad_words_components()
+        matchers, histories = [], []
+        for i in batch_indices:
+            params = custom_params[i]
+            req = params["__req__"]
+            words = params["bad_words_token_ids"]
+            cached = getattr(req, "_bad_words_rust_index", None)
+            if cached is None or cached[0] is not words:
+                matcher = matcher_type(words)
+                cached = (words, matcher, matcher.max_prefix)
+                req._bad_words_rust_index = cached
+            _, matcher, max_prefix = cached
+            matchers.append(matcher)
+            histories.append(list(req.output_ids[-max_prefix:]) if max_prefix else [])
+        candidates = (
+            [draft_rows[i] for i in batch_indices] if draft_rows is not None else None
+        )
+        rows, tokens = match_batch(
+            matchers, histories, candidates, batch_indices, width, parallel=parallel
+        )
+        return BadWordsLogitsProcessor._mask(logits, rows, tokens)
+
+    def apply_batch(self, logits, custom_params, batch_indices, width, draft_rows):
+        if _BAD_WORDS_BACKEND in ("rust", "rust_parallel"):
+            return self._apply_rust_batch(
+                logits,
+                custom_params,
+                batch_indices,
+                width,
+                draft_rows,
+                parallel=_BAD_WORDS_BACKEND == "rust_parallel",
+            )
+        rows, tokens = [], []
+        for i in batch_indices:
+            params = custom_params[i]
+            index, max_prefix = self._compiled(params)
+            history = params["__req__"].output_ids
+            # Bound the history copy independently of output length.
+            effective = list(history[-max_prefix:]) if max_prefix else []
+            for position in range(width):
+                if position and max_prefix:
+                    effective.append(draft_rows[i][position])
+                    if len(effective) > max_prefix:
+                        del effective[0]
+                self._collect(index, effective, i * width + position, rows, tokens)
+        return self._mask(logits, rows, tokens)
+
+    def __call__(self, logits, custom_param_list, *, histories=None):
+        rows, tokens = [], []
+        for row, params in enumerate(custom_param_list):
+            index, _ = self._compiled(params)
+            history = (
+                params["__req__"].output_ids if histories is None else histories[row]
+            )
+            self._collect(index, history, row, rows, tokens)
+        return self._mask(logits, rows, tokens)
