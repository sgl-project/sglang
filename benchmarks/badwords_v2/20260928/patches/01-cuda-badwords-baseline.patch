+    def test_overlapping_prefixes_produce_unique_coordinates(self):
+        processor = BadWordsLogitsProcessor()
+        entry = params([[1, 2], [2], [0, 1, 2]], [0, 1])
+        index, _ = processor._compiled(entry)
+        rows, tokens = [], []
