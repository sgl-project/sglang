diff --git a/aiter/ops/triton/attention/unified_attention.py b/aiter/ops/triton/attention/unified_attention.py
--- a/aiter/ops/triton/attention/unified_attention.py
+++ b/aiter/ops/triton/attention/unified_attention.py
@@ -293,6 +293,14 @@ def use_2d_kernel(
     # if IS_DEVICE_ARCH_GFX12, always use 3D if all_decode and 2D otherwise
     if IS_DEVICE_ARCH_GFX12:
         return (sliding_window > 0) or (not all_decode)

+    # Sliding-window decode takes the 3D (split-K) kernel as well. The 2D
+    # kernel keeps the whole KV loop inside one program per query tile, so a
+    # 2048-token window decode is several times slower than the split-K 3D
+    # kernel on gfx950 even though it reads less KV. Both kernels apply the
+    # same window mask, so the result is unchanged.
+    if all_decode and sliding_window > 0:
+        return False
+
     if head_size >= 512 and not get_arch().is_rdna and not all_decode:
         return True
