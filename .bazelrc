common --enable_bzlmod
common --lockfile_mode=error

build --show_timestamps
build --verbose_failures

test --test_output=errors
test --test_timeout=300

build:ci --announce_rc
build:ci --color=yes
test:ci --flaky_test_attempts=1

build:cpu --platforms=//bazel/platforms:linux_x86_64_cpu
build:cuda --platforms=//bazel/platforms:linux_x86_64_cuda
build:rocm --platforms=//bazel/platforms:linux_x86_64_rocm
build:rocm --extra_toolchains=//bazel/rocm:local_toolchain

build:manylinux --platforms=//bazel/platforms:linux_x86_64_manylinux_cpu
build:manylinux --extra_toolchains=@manylinux_llvm//:cc-toolchain-x86_64-linux
build:manylinux --@rules_rust//rust/settings:toolchain_linker_preference=cc

# Integration targets intentionally consume the already-provisioned SGLang
# runtime used by hardware CI. They are transitional until every native wheel
# is represented as a Bazel dependency.
test:cuda --test_tag_filters=-requires-rocm
test:rocm --test_tag_filters=-requires-cuda
