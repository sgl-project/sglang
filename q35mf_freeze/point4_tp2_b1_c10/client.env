MODEL=nvidia/Qwen3.5-397B-A17B-NVFP4
MODEL_PREFIX=qwen3.5
FRAMEWORK=dynamo-sglang
PRECISION=fp4
EVAL_ONLY=false
IS_AGENTIC=1
SPEC_DECODING=mtp
SCENARIO_TYPE=agentic-coding
AIPERF_EXPERIMENTAL_FAST=0
AIPERF_DRAIN_TIMEOUT_SECONDS=1800
AIPERF_DRAIN_POLL_SECONDS=10
PYTHONDONTWRITEBYTECODE=1
PYTHONPYCACHEPREFIX=/tmp/inferencex-pycache
KV_OFFLOADING=dram
KV_OFFLOAD_BACKEND=hicache
KV_OFFLOAD_BACKEND_METADATA='{"name": "hicache"}'
TOTAL_CPU_DRAM_GB=811
DISAGG=false
RUNNER_TYPE=gb300-nv
INFMAX_CONTAINER_WORKSPACE=/infmax-workspace
RESULT_DIR=/logs/agentic
PORT=8000
IS_MULTINODE=false
TP=2
WEKA_LOADER_OVERRIDE=semianalysis_cc_traces_weka_062126_256k
AIPERF_DATASET_MMAP_CACHE_DIR=/aiperf_mmap_cache
HF_HUB_CACHE=/hf_hub_cache
AIPERF_HTTP_X_DYNAMO_SESSION_ID_FROM_CORRELATION_ID=true
AIPERF_USE_DYNAMO_CONV_AWARE_ROUTING=0
AIPERF_REQUIRED_SERVER_METRIC_PREFIX=sglang:
CONC=10
CONC_LIST=10
DURATION=3600
RESULT_FILENAME=<RESULT_NAME>
IMAGE=lmsysorg/sglang:nightly-dev-cu13-20261015-a6a8c560
PREFILL_NUM_WORKERS=1
PREFILL_TP=2
PREFILL_PP_SIZE=1
PREFILL_EP=1
PREFILL_DP_ATTN=false
DECODE_NUM_WORKERS=0
DECODE_TP=0
DECODE_EP=0
DECODE_DP_ATTN=false
SRTCTL_FRONTEND_TYPE=sglang
SRT_FRONTEND_HOST=<NODE0_IP>
SRT_FRONTEND_PORT=8000
AIPERF_SERVER_METRICS_URLS=http://<NODE0_IP>:6100/metrics
AGENTIC_OUTPUT_DIR=/logs/agentic
