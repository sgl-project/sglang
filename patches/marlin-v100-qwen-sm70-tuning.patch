+inline bool sm70_marlin_moe_try_select_qwen3_5_122b_a10b_gptq_int4_params(
+    Sm70MarlinMoeAutoParamsContext const& ctx,
+    Sm70MarlinAutoParams& params) {
+  // Qwen/Qwen3.5-122B-A10B-GPTQ-Int4, TP=4, batch-1 decode w13.
+  // GPTQ symmetric int4 reaches Marlin as uint4b8, so it cannot use the
+  // otherwise shape-compatible AWQ (uint4) selector above. An exhaustive
+  // SM70 env sweep measured 149.50 us with split-K 8 versus 239.10 us for
+  // the generic split-K 1 fallback on a V100-SXM2-32GB.
+  if (ctx.quant_format == nullptr ||
+      std::strcmp(ctx.quant_format, "uint4b8") != 0 ||
+      ctx.group_size != 128 || ctx.size_m != 1 ||
+      ctx.moe_block_size != 8 || ctx.top_k != 8 ||
+      ctx.size_n != 512 || ctx.size_k != 3072) {
+    return false;
+  }
+
+  params = {{32, 256, 32, 4, 32, 64, 32},
+            8,
+            true,
+            ctx.packed_macro_n};
+  return true;
+}
