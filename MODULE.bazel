module(
    name = "sglang",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_rust_pyo3", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

tvm_ffi_wheel = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

tvm_ffi_wheel(
    name = "tvm_ffi_linux_x86_64",
    build_file_content = """
load("@rules_cc//cc:cc_import.bzl", "cc_import")

package(default_visibility = ["//visibility:public"])

cc_import(
    name = "tvm_ffi",
    hdrs = glob(["tvm_ffi/include/**/*.h"]),
    includes = ["tvm_ffi/include"],
    shared_library = "tvm_ffi/lib/libtvm_ffi.so",
)
""",
    sha256 = "78aa1857b04a2ea718317041ab3f01288b3d496e6036eb1b99ebdc9da0fdaef5",
    type = "zip",
    urls = ["https://files.pythonhosted.org/packages/36/99/2848df4e8ed5bf51df1d286d1718510584fa61e88adbc9c5b23d71b38f7c/apache_tvm_ffi-0.1.11-cp312-abi3-manylinux2014_x86_64.manylinux_2_17_x86_64.whl"],
)

sgl_kernel_source = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

sgl_kernel_source_build_file = """
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
)
"""

# Keep these archives aligned with the fallback FetchContent pins in
# python/sglang/kernels/aot/CMakeLists.txt and cmake/flashmla.cmake.
sgl_kernel_source(
    name = "sgl_kernel_cutlass",
    build_file_content = sgl_kernel_source_build_file,
    sha256 = "09237099a70f80bff1dc8bb80c843a674bb4fdcb46e43cc6993e711c5ca89bb5",
    strip_prefix = "cutlass-57e3cfb47a2d9e0d46eb6335c3dc411498efa198",
    urls = ["https://github.com/NVIDIA/cutlass/archive/57e3cfb47a2d9e0d46eb6335c3dc411498efa198.tar.gz"],
)

sgl_kernel_source(
    name = "sgl_kernel_fmt",
    build_file_content = sgl_kernel_source_build_file,
    patch_cmds = ["rm -f support/bazel/BUILD.bazel"],
    sha256 = "c314292789d28c3c3b420e75a7b2d1706f685f7fb63289128d46aeaea2c6be71",
    strip_prefix = "fmt-553ec11ec06fbe0beebfbb45f9dc3c9eabd83d28",
    urls = ["https://github.com/fmtlib/fmt/archive/553ec11ec06fbe0beebfbb45f9dc3c9eabd83d28.tar.gz"],
)

sgl_kernel_source(
    name = "sgl_kernel_triton",
    build_file_content = sgl_kernel_source_build_file,
    sha256 = "7d998625d1035ac496d06a81117727647169422ee67b8889609f06fd5367c491",
    strip_prefix = "triton-3.7.1",
    urls = ["https://github.com/triton-lang/triton/archive/v3.7.1.tar.gz"],
)

sgl_kernel_source(
    name = "sgl_kernel_flashinfer",
    build_file_content = sgl_kernel_source_build_file,
    sha256 = "931dfd118f4b6de8c7d98702153c7c03840139170af21a07607693bd9749744d",
    strip_prefix = "flashinfer-bc29697ba20b7e6bdb728ded98f04788e16ee021",
    urls = ["https://github.com/flashinfer-ai/flashinfer/archive/bc29697ba20b7e6bdb728ded98f04788e16ee021.tar.gz"],
)

sgl_kernel_source(
    name = "sgl_kernel_sgl_attn",
    build_file_content = sgl_kernel_source_build_file,
    sha256 = "418b5681584dc3efff496a1cab5ffd58d2728d89dcfe0ea16e6985d6ef35c68c",
    strip_prefix = "sgl-flash-attn-f89bc2306632d1ec5f97b014dded4254f5b4a907",
    urls = ["https://github.com/sgl-project/sgl-attn/archive/f89bc2306632d1ec5f97b014dded4254f5b4a907.tar.gz"],
)

sgl_kernel_source(
    name = "sgl_kernel_flashmla",
    build_file_content = sgl_kernel_source_build_file,
    sha256 = "ce369489bbfc42cdfbba9aa949de0270e64469d530748dea9f4f60b3c69dea9b",
    strip_prefix = "FlashMLA-05e26647fe840b8baedae486c2d86d5ce4efeb7c",
    urls = ["https://github.com/sgl-project/FlashMLA/archive/05e26647fe840b8baedae486c2d86d5ce4efeb7c.tar.gz"],
)

sgl_kernel_source(
    name = "sgl_kernel_flashmla_cutlass",
    build_file_content = sgl_kernel_source_build_file,
    sha256 = "9f6c53320a85b4a570975e557918cde65168cd311f081920446c238437347dc6",
    strip_prefix = "cutlass-147f5673d0c1c3dcf66f78d677fd647e4a020219",
    urls = ["https://github.com/NVIDIA/cutlass/archive/147f5673d0c1c3dcf66f78d677fd647e4a020219.tar.gz"],
)

rules_rust_pyo3_crates = use_extension(
    "@rules_rust_pyo3//private:internal_extensions.bzl",
    "rust_ext",
)
use_repo(
    rules_rust_pyo3_crates,
    "rpyo3c",
    "rpyo3c__pyo3-0.29.0",
    "rpyo3c__pyo3-ffi-0.29.0",
    "rpyo3c__pyo3-introspection-0.29.0",
)

register_execution_platforms(
    "//bazel/platforms:linux_x86_64_cpu",
    "//bazel/platforms:linux_x86_64_cuda",
    "//bazel/platforms:linux_x86_64_rocm",
)

# Python 3.12 matches the hosted CPU/lint jobs. Accelerator-specific Python
# hubs will be added separately because CUDA, ROCm, XPU, and NPU can share an
# OS/CPU tuple while requiring mutually incompatible wheels.
rules_python_config = use_extension(
    "@rules_python//python/extensions:config.bzl",
    "config",
)
rules_python_config.explicit_init_py(default = True)

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")
use_repo(
    python,
    "python_3_12",
    "python_versions",
    "pythons_hub",
)

register_toolchains("@pythons_hub//:all")

uv = use_extension(
    "@rules_python//python/uv:uv.bzl",
    "uv",
    dev_dependency = True,
)
uv.configure(version = "0.12.5")
use_repo(uv, "uv")

pip = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
)
pip.parse(
    hub_name = "srt_empty_bootstrap",
    python_version = "3.12",
    requirements_lock = "//bazel/python:srt_empty_bootstrap.requirements.lock.txt",
)
pip.parse(
    hub_name = "hf_management",
    python_version = "3.12",
    requirements_lock = "//bazel/python:hf_management.requirements.lock.txt",
)
pip.parse(
    hub_name = "runtime_import",
    python_version = "3.12",
    requirements_lock = "//bazel/python:runtime_import.requirements.lock.txt",
)
use_repo(
    pip,
    "hf_management",
    "runtime_import",
    "srt_empty_bootstrap",
)

# Keep the primary Cargo workspace authoritative. crate_universe mirrors its
# checked Cargo.lock and writes only the Bazel rendering lock below.
rust = use_extension(
    "@rules_rust//rust:extensions.bzl",
    "rust",
)
rust.toolchain(
    edition = "2024",
    versions = ["1.92.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

register_toolchains(
    "@rules_rust_pyo3//toolchains:toolchain",
    "//bazel/rust:sglang_rust_pyo3_toolchain",
)

crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)
crate.annotation(
    build_script_use_cc_toolchain = "on",
    crate = "esaxx-rs",
    repositories = ["sglang_crates"],
)
crate.annotation(
    build_script_use_cc_toolchain = "on",
    crate = "onig_sys",
    repositories = ["sglang_crates"],
)
crate.annotation(
    build_script_env = {
        "PROTOC": "$(execpath @@//bazel/rust:gateway_protoc)",
    },
    build_script_tools = ["@@//bazel/rust:gateway_protoc"],
    crate = "smg-grpc-client",
    repositories = ["sgl_model_gateway_crates"],
    version = "1.0.0",
)
crate.annotation(
    build_script_env = {
        "PROTOC": "$(execpath @@//bazel/rust:gateway_protoc)",
    },
    build_script_tools = ["@@//bazel/rust:gateway_protoc"],
    crate = "smg-mesh",
    repositories = ["sgl_model_gateway_crates"],
    version = "1.0.0",
)
crate.from_cargo(
    name = "sglang_crates",
    cargo_lockfile = "//rust:Cargo.lock",
    lockfile = "//bazel/rust:sglang-crates.lock.json",
    manifests = ["//rust:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "sgl_model_gateway_crates",
    cargo_lockfile = "//sgl-model-gateway:Cargo.lock",
    lockfile = "//bazel/rust:sgl-model-gateway-crates.lock.json",
    manifests = ["//sgl-model-gateway:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(
    crate,
    "sgl_model_gateway_crates",
    "sglang_crates",
    "sglang_crates__rayon-1.12.0",
)
