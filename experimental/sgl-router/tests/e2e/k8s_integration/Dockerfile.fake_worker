FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi uvicorn grpcio grpcio-tools protobuf
COPY experimental/sgl-router/tests/e2e/k8s_integration/fake_worker.py .
COPY proto/sglang/router/loadmonitor/v1/load_monitor.proto sglang/router/loadmonitor/v1/load_monitor.proto
EXPOSE 30000 31000
CMD ["python", "fake_worker.py"]
