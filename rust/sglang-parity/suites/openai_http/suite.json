{
  "name": "openai_http",
  "comparison": {
    "base": "exact_json",
    "per_result_value_exceptions": [
      {
        "path": "/id",
        "presence": "optional",
        "require": "non_empty_string",
        "reason": "Response IDs vary per request; presence and type remain checked."
      },
      {
        "path": "/created",
        "presence": "optional",
        "require": "non_negative_number",
        "reason": "Creation times vary per request; presence and type remain checked."
      }
    ]
  },
  "streaming": {
    "envelope": {
      "id": "chat_constant",
      "created": "constant",
      "object": "constant",
      "model": "constant",
      "system_fingerprint": "constant",
      "service_tier": "constant",
      "metadata": "constant",
      "usage": "usage"
    },
    "completion": {
      "index": "index",
      "text": "text",
      "logprobs": "logprobs",
      "finish_reason": "terminal",
      "matched_stop": "terminal"
    },
    "chat": {
      "index": "index",
      "delta": "delta",
      "logprobs": "logprobs",
      "finish_reason": "terminal",
      "matched_stop": "terminal"
    },
    "delta": {
      "role": "constant",
      "content": "text",
      "reasoning_content": "text",
      "refusal": "text",
      "tool_calls": "constant",
      "function_call": "constant"
    }
  },
  "equivalence": [
    "model",
    "content",
    "finish_reason",
    "logprobs",
    "usage"
  ],
