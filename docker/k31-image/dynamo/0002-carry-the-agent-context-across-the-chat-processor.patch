+/// K3.1 session affinity: the parent session id of a subagent request. The OpenAI preprocessor copies it
+/// onto the request; the Python chat-processor path (`RoutedEngine`) carries it only in the
+/// request context registry, so fall back to that.
+fn parent_session_id(request: &SingleIn<PreprocessedRequest>) -> Option<String> {
+    if let Some(context) = request.content().agent_context.as_ref() {
+        return context.parent_session_id.clone();
+    }
+    request
+        .get_optional::<AgentContext>(AGENT_CONTEXT_CONTEXT_KEY)
+        .ok()
+        .flatten()
+        .and_then(|context| context.parent_session_id.clone())
+}
