+#[tokio::test]
+#[serial_test::serial]
+async fn aria_s1_unbound_group_starts_on_the_parent_worker() {
+    let workers = [7u64, 9]
+        .into_iter()
+        .map(|worker_id| (worker_id, ModelRuntimeConfig::default()))
+        .collect();
+    let (router, runtime) =
+        router_with_worker_configs(Some(Duration::from_secs(60)), workers).await;
+    let affinity = router.affinity.as_ref().unwrap();
+
+    // The parent session is bound to worker 9.
+    let Hold::Initialize(parent) = affinity
+        .acquire(&SessionAffinityId::new("parent-1"), None)
+        .await
+        .unwrap()
+    else {
+        panic!("the parent must initialize its own session");
+    };
+    drop(
+        parent
+            .commit(crate::session_affinity::to_table(AffinityTarget::new(
+                9,
+                Some(0),
+            )))
+            .unwrap(),
+    );
+
+    let offered = async |request: &SingleIn<PreprocessedRequest>| {
+        router
+            .select_with_session_affinity(
+                request,
+                RequestPhase::Aggregated,
+                false,
+                &CleanupBudget::default(),
+                |target| std::future::ready(Ok(target)),
+            )
+            .await
+            .unwrap()
+    };
+
+    // The parent link is in the registry only, as on the RoutedEngine path.
+    let first = registry_subagent_request("child-1", "parent-1");
+    assert!(first.content().agent_context.is_none());
+    assert_eq!(
+        router.group_binding_id(&first, None).unwrap().as_str(),
+        parent_group_id("parent-1").as_str()
+    );
+    let (offered_first, hold) = offered(&first).await;
+    assert_eq!(offered_first, Some(AffinityTarget::new(9, Some(0))));
+    assert!(matches!(hold, Some(Hold::Initialize(_))));
+    let mut stream = router
+        .bind_affinity(
+            hold,
+            AffinityTarget::new(9, Some(0)),
+            ResponseStream::new(
+                Box::pin(stream::iter([Annotated::from_data(
+                    LLMEngineOutput::default(),
+                )])),
+                first.context(),
+            ),
+        )
+        .unwrap();
+    while stream.next().await.is_some() {}
+    assert_eq!(
+        affinity
+            .query_target(&parent_group_id("parent-1"), None)
+            .unwrap(),
+        Some(AffinityTarget::new(9, Some(0)))
+    );
+
+    // A child whose parent has no binding starts unbound, as before.
+    let orphan = registry_subagent_request("child-3", "parent-2");
+    let (offered_orphan, _) = offered(&orphan).await;
+    assert_eq!(offered_orphan, None);
+
+    // A failing seeded selection falls back to an unseeded one instead of failing the request.
+    let sibling_of_orphan = registry_subagent_request("child-4", "parent-3");
+    let Hold::Initialize(parent3) = affinity
+        .acquire(&SessionAffinityId::new("parent-3"), None)
+        .await
+        .unwrap()
+    else {
+        panic!("parent-3 must initialize");
+    };
+    drop(
+        parent3
+            .commit(crate::session_affinity::to_table(AffinityTarget::new(
+                7,
+                Some(0),
+            )))
+            .unwrap(),
+    );
+    let (selected, operation) = router
+        .select_with_session_affinity(
+            &sibling_of_orphan,
+            RequestPhase::Aggregated,
+            false,
+            &CleanupBudget::default(),
+            |target: Option<AffinityTarget>| {
+                std::future::ready(match target {
+                    Some(_) => Err(anyhow::anyhow!("pinned selection failed")),
+                    None => Ok(None::<AffinityTarget>),
+                })
+            },
+        )
+        .await
+        .unwrap();
+    assert_eq!(selected, None);
+    assert!(matches!(operation, Some(Hold::Initialize(_))));
+
+    runtime.shutdown();
+}
