+    fn parent_seed(
+        &self,
+        affinity: &AffinityCoordinator,
+        request: &SingleIn<PreprocessedRequest>,
+        explicit: Option<AffinityTarget>,
+    ) -> Option<AffinityTarget> {
+        if explicit.is_some() {
+            return None;
+        }
+        let parent = SessionAffinityId::new(parent_session_id(request)?);
+        let target = affinity.query_target(&parent, None).ok().flatten()?;
+        if !self.affinity_target_is_valid(target) {
+            return None;
+        }
