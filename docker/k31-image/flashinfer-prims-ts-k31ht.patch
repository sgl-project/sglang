     descriptor, rows = decode_sparse_quad(primary, extra, raw)
+    if cutlass.const_expr(fallback is not None):
+        # K31HT_MLA_TAILROW: a masked coordinate (0x7FFFFFFF, an
+        # out-of-bounds TMA zero-fill row) becomes the tile's token-0 row when that row carries the quad's
+        # source tag (sign bits of fallback and raw[0] agree). A masked fallback maps to 0x7FFFFFFF itself,
+        # so the served coordinate is kept. SMEM offsets, the score mask and expect-tx are untouched.
+        fb_row = fallback & Int32(0x7FFFFFFF)
+        masked_row = fb_row if (fallback ^ raw[0]) >= Int32(0) else Int32(0x7FFFFFFF)
+        for j in cutlass.range_constexpr(TMA_GATHER_ROWS):
+            rows[j] = masked_row if rows[j] == Int32(0x7FFFFFFF) else rows[j]
     _gather4_slices(
         dst,
         descriptor,
