diff --git b/_k31ht_knobs.py b/_k31ht_knobs.py
new file mode 100644
index 0000000..ff42742
--- /dev/null
+++ b/_k31ht_knobs.py
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+"""K31HT_MLA_TAILROW: map masked sparse-MLA gather rows to a valid row of the same tile at the TMA issue (served FP8 2-CTA path).
+
+'0' / unset = served (masked rows -> out-of-bounds TMA zero fill). '1' = on: in SmemKResource / SmemVResource.tma_load_shared
+(gather4_uniform_quad_slices), a masked row coordinate becomes the tile's token-0 row when that row is valid and has the same
+source tag; the SMEM offsets, the score mask and the expect-tx bytes are unchanged (masked scores are replaced before the row max,
+P = 0 on those columns). Only tiles whose row 127 is masked take the substituted loop; other tiles run the served loop text.
+Anything else raises at import.
+"""
+import os
+
+_v = os.environ.get("K31HT_MLA_TAILROW", "0")
+if _v not in ("0", "1"):
+    raise ValueError(f"K31HT_MLA_TAILROW must be '0' or '1', got {_v!r}")
+TAILROW = _v == "1"
+# Compile-cache identity: both settings share the source text, so the key must carry the knob.
+KEY = ("K31HT_MLA_TAILROW", TAILROW)
+_engaged = set()
+
+
+def engage(site):
+    """Print one ENGAGE line per process and site when the knob's branch is traced."""
+    if site not in _engaged:
+        _engaged.add(site)
+        print(f"K31HT_MLA_TAILROW ENGAGE site={site} pid={os.getpid()}", flush=True)
