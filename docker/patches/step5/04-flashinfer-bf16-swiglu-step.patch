+// FC1 is deliberately materialized in BF16 before applying the Step activation.
+// Its logical rows are [up, gate], without fused-SwiGLU row interleaving.
+__global__ void stepBf16Activation(__nv_bfloat16 const* input, __nv_bfloat16* output,
+                                  int32_t const* paddedTokens, int32_t width,
+                                  float const* limits, int32_t const* ctaToExpert,
+                                  int32_t tileTokens) {
+  int32_t row = blockIdx.x;
+  if (row >= *paddedTokens) return;
+  float limit = limits ? limits[ctaToExpert[row / tileTokens]] : 7.0f;
+  for (int32_t col = threadIdx.x; col < width; col += blockDim.x) {
+    int64_t base = static_cast<int64_t>(row) * (2 * width);
+    float up = __bfloat162float(input[base + col]);
+    float gate = __bfloat162float(input[base + width + col]);
+    float silu = gate / (1.0f + expf(-gate));
+    output[static_cast<int64_t>(row) * width + col] =
+        __float2bfloat16_rn(fminf(silu, limit) * fmaxf(-limit, fminf(up, limit)));
+  }
+}
+

