+def _normalize_fc1_output_dtype(
+    fc1_output_dtype: Optional[str],
+    fp8_quantization_type: Fp8QuantizationType,
+    activation_type: int,
+) -> int:
+    """Validate the public ``fc1_output_dtype`` selector and map it to the kernel mode.
+
+    ``None`` (default) and ``"e4m3"`` select the legacy E4M3 FC1 intermediate;
+    ``"bf16"`` selects the explicit Bfloat16 FC1 output (DeepSeekFp8 + Swiglu only).
+    """
+    if fc1_output_dtype is None or fc1_output_dtype == "e4m3":
+        return 0
+    if fc1_output_dtype != "bf16":
+        raise ValueError(
+            f"fc1_output_dtype must be None, 'e4m3', or 'bf16'; got {fc1_output_dtype!r}."
+        )
+    if Fp8QuantizationType(fp8_quantization_type) != Fp8QuantizationType.DeepSeekFp8:
+        raise ValueError(
+            "fc1_output_dtype='bf16' is only supported for "
+            f"fp8_quantization_type=DeepSeekFp8, got {Fp8QuantizationType(fp8_quantization_type)}."
+        )
+    if int(activation_type) != int(ActivationType.Swiglu):
+        raise ValueError(
+            "fc1_output_dtype='bf16' is only supported for activation_type=Swiglu, "
+            f"got activation_type={activation_type}."
+        )
+    return 1
+
