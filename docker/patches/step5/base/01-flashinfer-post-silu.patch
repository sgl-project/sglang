+def _normalize_silu_clamp_mode(
+    silu_clamp_mode: Optional[str],
+    fp8_quantization_type: Fp8QuantizationType,
+    activation_type: int,
+    gemm1_clamp_limit: Optional[torch.Tensor],
+) -> int:
+    """Validate the public ``silu_clamp_mode`` selector and map it to the kernel mode.
+
+    ``None`` (default) and ``"pre"`` select the legacy pre-SiLU clamp
+    (``min(gate, limit)`` before the SiLU). ``"post"`` selects the post-SiLU clamp
+    (``min(silu(gate), limit)``), which is only valid for DeepSeekFp8 + Swiglu with
+    ``gemm1_clamp_limit`` set.
+    """
+    if silu_clamp_mode is None or silu_clamp_mode == "pre":
+        return 0
+    if silu_clamp_mode != "post":
+        raise ValueError(
+            f"silu_clamp_mode must be None, 'pre', or 'post'; got {silu_clamp_mode!r}."
+        )
+    if Fp8QuantizationType(fp8_quantization_type) != Fp8QuantizationType.DeepSeekFp8:
+        raise ValueError(
+            "silu_clamp_mode='post' is only supported for "
+            f"fp8_quantization_type=DeepSeekFp8, got {Fp8QuantizationType(fp8_quantization_type)}."
+        )
+    if int(activation_type) != int(ActivationType.Swiglu):
+        raise ValueError(
+            "silu_clamp_mode='post' is only supported for activation_type=Swiglu, "
+            f"got activation_type={activation_type}."
+        )
+    if gemm1_clamp_limit is None:
+        raise ValueError("silu_clamp_mode='post' requires gemm1_clamp_limit to be set.")
+    return 1
+
+
+def _check_silu_clamp_mode_int(
