+) -> None:
+    """Op-level validation for the integer silu_clamp_mode (direct op callers)."""
+    if silu_clamp_mode not in (0, 1):
+        raise ValueError(f"silu_clamp_mode must be 0 or 1, got {silu_clamp_mode}.")
+    if silu_clamp_mode == 1:
