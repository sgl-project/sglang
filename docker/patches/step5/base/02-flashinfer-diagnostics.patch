+/** Clone one 2D launcher-owned buffer into an independent tensor on the given stream. */
+static Tensor cloneLauncherTensor2D(Tensor const& src, cudaStream_t stream) {
+  TVM_FFI_ICHECK_EQ(src.ndim(), 2) << "diagnostic clone expects a 2D tensor.";
+  Tensor dst = alloc_tensor({src.size(0), src.size(1)}, src.dtype(), src.device());
+  size_t const nbytes = static_cast<size_t>(src.numel()) * src.dtype().bits / 8;
+  cudaError_t const err =
+      cudaMemcpyAsync(dst.data_ptr(), src.data_ptr(), nbytes, cudaMemcpyDeviceToDevice, stream);
+  FLASHINFER_CHECK(err == cudaSuccess,
+                   "diagnostic clone cudaMemcpyAsync failed: ", cudaGetErrorString(err));
+  return dst;
+}
