+template <typename KernelParams>
+__global__ void permuteVectorKernel(KernelParams params) {
+  using Type = typename KernelParams::Type;
+  using Vec = uint32_t;
+  constexpr int kElements = sizeof(Vec) / sizeof(Type);
+  static_assert(sizeof(Vec) % sizeof(Type) == 0);
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+  if constexpr (KernelParams::UsePdl) {
+    cudaTriggerProgrammaticLaunchCompletion();
+    cudaGridDependencySynchronize();
+  }
+#endif
+  int const vectorsPerRow = params.hiddenDim / kElements;
+  auto const* input = reinterpret_cast<Vec const*>(params.inPtr);
+  auto* output = reinterpret_cast<Vec*>(params.outPtr);
+  for (int tokenIdx = blockIdx.y; tokenIdx < params.numTokens; tokenIdx += gridDim.y) {
+    for (int vectorIdx = threadIdx.x + blockDim.x * blockIdx.x;
+         vectorIdx < vectorsPerRow; vectorIdx += blockDim.x * gridDim.x) {
+      Vec const value = input[int64_t(tokenIdx) * vectorsPerRow + vectorIdx];
+#pragma unroll
+      for (int k = 0; k < 8; ++k) {
+        int const permutedIdx = params.expandedIdxToPermutedIdx[tokenIdx * 8 + k];
+        if (permutedIdx >= 0) {
+          output[int64_t(permutedIdx) * vectorsPerRow + vectorIdx] = value;
+        }
+      }
+    }
+    for (int scaleIdx = threadIdx.x + blockDim.x * blockIdx.x;
+         scaleIdx < params.hiddenDim / 128; scaleIdx += blockDim.x * gridDim.x) {
+      float const scale = params.inDqSfsPtr[tokenIdx + int64_t(params.numTokens) * scaleIdx];
+      int const padded = params.totalNumPaddedTokens[0];
+#pragma unroll
+      for (int k = 0; k < 8; ++k) {
+        int const permutedIdx = params.expandedIdxToPermutedIdx[tokenIdx * 8 + k];
+        if (permutedIdx >= 0) {
+          params.outDqSfsPtr[permutedIdx + int64_t(padded) * scaleIdx] = scale;
+        }
+      }
+    }
+  }
+}
