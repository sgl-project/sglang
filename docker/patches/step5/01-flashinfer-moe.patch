+// Step5 BF16 FC1: one warp owns one routed token's 128-element scale block.
+// The route predicate is warp-uniform. No CTA-wide reduction or shared scale
+// exchange is needed, so absent routes leave before all activation arithmetic.
+template <typename KernelParams>
+__global__ void activationDeepSeekWarpKernel(KernelParams params) {
+  using TypeOut = typename KernelParams::TypeOut;
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+  if constexpr (KernelParams::UsePdl) {
+    cudaTriggerProgrammaticLaunchCompletion();
+    cudaGridDependencySynchronize();
+  }
+#endif
+  constexpr int WarpSize = 32;
+  constexpr int TokensPerCta = 4;
+  constexpr float E4m3MaxVal = 448.f;
+  int const lane = threadIdx.x % WarpSize;
+  int const warp = threadIdx.x / WarpSize;
+  int const totalNumPaddedTokens = params.totalNumPaddedTokens[0];
+  int const outputDim = params.innerDim / 2;
+  int const hiddenBase = blockIdx.x * 128;
+
+  for (int k = blockIdx.z; k < params.topK; k += gridDim.z) {
+    for (int tokenIdx = blockIdx.y * TokensPerCta + warp; tokenIdx < params.numTokens;
+         tokenIdx += gridDim.y * TokensPerCta) {
+      int const permutedIdx = params.expandedIdxToPermutedIdx[tokenIdx * params.topK + k];
+      if (permutedIdx == -1) {
+        continue;
+      }
+      float values[4];
+      float aMax = 0.0f;
+      int const laneBase = hiddenBase + lane * 4;
+      int64_t const inputIdx = (int64_t)permutedIdx * params.innerDim + laneBase;
+      uint2 const linearBits = *reinterpret_cast<uint2 const*>(params.inPtr + inputIdx);
+      uint2 const gluBits = *reinterpret_cast<uint2 const*>(params.inPtr + inputIdx + outputDim);
+      auto const* linearVals = reinterpret_cast<cutlass::bfloat16_t const*>(&linearBits);
+      auto const* gluVals = reinterpret_cast<cutlass::bfloat16_t const*>(&gluBits);
+#pragma unroll
+      for (int element = 0; element < 4; ++element) {
+        float const xLinear = static_cast<float>(linearVals[element]);
+        float const xGlu = static_cast<float>(gluVals[element]);
+        values[element] = gatedSilu(params, permutedIdx, xLinear, xGlu);
+        aMax = fmaxf(aMax, fabsf(values[element]));
+      }
+#pragma unroll
+      for (int delta = WarpSize / 2; delta > 0; delta /= 2) {
+        aMax = fmaxf(aMax, __shfl_xor_sync(0xffffffff, aMax, delta));
+      }
+      float const scaleOut = fmaxf(aMax / E4m3MaxVal, std::numeric_limits<float>::min());
+      if (lane == 0) {
+        int64_t const scaleIdx =
+            (int64_t)permutedIdx + (int64_t)totalNumPaddedTokens * blockIdx.x;
+        params.outDqSfsPtr[scaleIdx] = scaleOut;
+      }
+      uint32_t packed;
+      auto* packedVals = reinterpret_cast<TypeOut*>(&packed);
+#pragma unroll
+      for (int element = 0; element < 4; ++element) {
+        packedVals[element] = static_cast<TypeOut>(values[element] / scaleOut);
+      }
+      int64_t const outputIdx = (int64_t)permutedIdx * outputDim + laneBase;
+      *reinterpret_cast<uint32_t*>(params.outPtr + outputIdx) = packed;
+    }
+  }
+}
