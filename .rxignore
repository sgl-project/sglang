# .rxignore — patterns mutagen will SKIP when bidirectionally syncing
# this folder to your devbox. Same syntax as .gitignore (glob patterns).
#
# Auto-generated by `rx devbox sync start`. Edit freely — `rx` honors
# the file as-is on subsequent `sync start` invocations. A small set
# of patterns (.git, .mutagen, node_modules, __pycache__, .DS_Store)
# is ALWAYS skipped regardless of this file to protect your devbox
# from accidentally pulling in repo internals.

# Build outputs
target/
dist/
build/
out/

# Python virtual envs + caches
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ML artifacts — usually big, usually generated on the devbox
*.safetensors
*.ckpt
*.bin
*.pt
*.pth
*.npz
*.parquet
*.arrow
data/
datasets/
checkpoints/
wandb/
mlruns/
runs/
outputs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS junk
Thumbs.db
