{
  "$ref": "#/$defs/ClaimState",
  "$defs": {
    "ClaimState": {
      "title": "ClaimState",
      "description": "Current owner-confirmed protection, independent of operation completion.",
      "type": "object",
      "properties": {
        "caller_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "task_incarnation": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "active",
            "expired",
            "invalidated",
            "released",
            "unknown"
          ]
        },
        "owner_epoch": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "protection_version": {
          "enum": [
            "1.0"
          ],
          "default": "1.0"
        },
        "tombstone": {
          "type": "boolean",
          "default": false
        },
        "effective_protection": {
          "anyOf": [
            {
              "enum": [
                "backend_soft_pin",
                "eviction_exclusion",
                "eviction_priority"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remaining_ttl": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 31536000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "owner_task": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetOutcome"
          },
          "default": []
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "caller_id",
        "task_incarnation",
        "claim_id",
        "revision",
        "state",
        "owner_epoch"
      ],
      "additionalProperties": false
    },
    "TaskIdentity": {
      "title": "TaskIdentity",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "incarnation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "session_id",
        "incarnation"
      ],
      "additionalProperties": false
    },
    "TargetOutcome": {
      "title": "TargetOutcome",
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/TokenRange"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "branch_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0
        },
        "content_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "default": []
        },
        "code": {
          "type": "string",
          "default": ""
        },
        "reason": {
          "type": "string",
          "default": ""
        },
        "coverage_kind": {
          "enum": [
            "checkpoint",
            "tokens",
            "window"
          ],
          "default": "tokens"
        },
        "window_size": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "coverage",
        "status"
      ],
      "additionalProperties": false
    },
    "TokenRange": {
      "title": "TokenRange",
      "type": "object",
      "properties": {
        "start_token": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_token": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "component": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "start_token",
        "end_token"
      ],
      "additionalProperties": false
    },
    "Status": {
      "title": "Status",
      "enum": [
        "accepted",
        "cancelled",
        "cancelling",
        "completed",
        "deferred",
        "failed",
        "missing",
        "partial",
        "queued",
        "received",
        "rejected",
        "running",
        "unconsumed",
        "unsupported"
      ]
    },
    "Location": {
      "title": "Location",
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "gpu",
            "host",
            "storage"
          ]
        },
        "engine_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend_namespace": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "tier"
      ],
      "additionalProperties": false
    },
    "PublicLocation": {
      "title": "PublicLocation",
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "gpu",
            "host",
            "storage"
          ]
        },
        "engine_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend_namespace": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "tier"
      ],
      "additionalProperties": false
    }
  }
}
