{
  "$defs": {
    "Prefetch": {
      "title": "Prefetch",
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "enum": [
                "request_cached"
              ]
            },
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/TokensTarget"
                },
                {
                  "$ref": "#/$defs/PrefixTarget"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "tokens": "#/$defs/TokensTarget",
                  "prefix": "#/$defs/PrefixTarget"
                }
              }
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/PublicLocation"
        },
        "destination": {
          "$ref": "#/$defs/PublicLocation"
        },
        "allow_partial": {
          "type": "boolean",
          "default": false
        },
        "timeout_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "target",
        "source",
        "destination"
      ],
      "additionalProperties": false
    },
    "TokensTarget": {
      "title": "TokensTarget",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "tokens"
          ]
        },
        "cache_salt": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extra_key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layout_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_multimodal": {
          "type": "boolean",
          "default": false
        },
        "namespace": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "token_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxItems": 65536,
          "minItems": 1
        },
        "start_token": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0
        },
        "end_token": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "allow_clip": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "kind",
        "namespace",
        "token_ids"
      ],
      "additionalProperties": false
    },
    "PrefixTarget": {
      "title": "PrefixTarget",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "prefix"
          ]
        },
        "compatibility": {
          "$ref": "#/$defs/PrefixCompatibility"
        },
        "start_token": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_token": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "token_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "maxItems": 65536,
              "minItems": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrefixBlock"
          },
          "maxItems": 4096,
          "default": []
        }
      },
      "required": [
        "kind",
        "compatibility",
        "start_token",
        "end_token"
      ],
      "additionalProperties": false
    },
    "PrefixCompatibility": {
      "title": "PrefixCompatibility",
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "cache_salt": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "layout_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "maxItems": 64,
          "minItems": 1
        },
        "hash_scheme": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "required": [
        "namespace",
        "cache_salt",
        "layout_id",
        "page_size",
        "components",
        "hash_scheme"
      ],
      "additionalProperties": false
    },
    "PrefixBlock": {
      "title": "PrefixBlock",
      "type": "object",
      "properties": {
        "block_hash": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(0|-[1-9][0-9]*|[1-9][0-9]*)$"
        },
        "component": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "start_token": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_token": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dependency_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0
        }
      },
      "required": [
        "block_hash",
        "component",
        "start_token",
        "end_token"
      ],
      "additionalProperties": false
    },
    "PublicLocation": {
      "title": "PublicLocation",
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "gpu",
            "host",
            "storage"
          ]
        },
        "engine_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend_namespace": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "tier"
      ],
      "additionalProperties": false
    },
    "Pin": {
      "title": "Pin",
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "acquire",
            "release",
            "renew"
          ]
        },
        "target": {
          "anyOf": [
            {
              "enum": [
                "request_cached"
              ]
            },
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/TokensTarget"
                },
                {
                  "$ref": "#/$defs/PrefixTarget"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "tokens": "#/$defs/TokensTarget",
                  "prefix": "#/$defs/PrefixTarget"
                }
              }
            }
          ]
        },
        "location": {
          "$ref": "#/$defs/PublicLocation"
        },
        "claim_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 31536000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_protection": {
          "anyOf": [
            {
              "enum": [
                "backend_soft_pin",
                "eviction_exclusion",
                "eviction_priority"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "owner_task": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "target",
        "location",
        "claim_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "TaskIdentity": {
      "title": "TaskIdentity",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "incarnation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "session_id",
        "incarnation"
      ],
      "additionalProperties": false
    }
  }
}
