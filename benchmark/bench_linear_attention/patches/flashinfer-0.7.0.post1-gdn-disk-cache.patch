+# Cache adapter for GDN's explicit compile-key protocol. Keep the existing
+# process-local fast path; disk access happens only on its first miss.
+def _disk_key_value(value):
+    import enum
+    import math
+
+    if isinstance(value, enum.Enum):
+        return ["enum", type(value).__module__, type(value).__qualname__, value.name]
+    if value is None or type(value) in (bool, int, str):
+        return value
+    if type(value) is float and math.isfinite(value):
+        return value
+    if isinstance(value, type):
+        return ["type", value.__module__, value.__qualname__]
+    if isinstance(value, torch.dtype):
+        return ["torch.dtype", str(value)]
+    if isinstance(value, (tuple, list)):
+        return [type(value).__name__, *(_disk_key_value(v) for v in value)]
+    # Never key on repr(object): an address is neither portable nor a complete
+    # specialization identity. Unsupported keys use the original compile path.
+    raise TypeError(f"Unsupported persistent GDN key value: {type(value)}")
+
+
+@functools.cache
+def _disk_source_hash():
+    import hashlib
+    import importlib.metadata
+    import json
+    import sys
+    from pathlib import Path
+
+    from flashinfer.jit.cute_dsl_core import _hash_source_files
+
+    family_root = Path(__file__).resolve().parent.parent
+    # Conservatively include all GDN implementation/helper sources, including
+    # this cache adapter. Exact source changes invalidate previous artifacts.
+    sources = tuple(str(p) for p in sorted(family_root.rglob("*.py")))
+    versions = {
+        name: importlib.metadata.version(name)
+        for name in ("flashinfer-python", "torch", "apache-tvm-ffi", "cuda-bindings")
+    }
+    versions["python_abi"] = sys.implementation.cache_tag
+    versions["gdn_sources"] = _hash_source_files(sources)
+    return hashlib.sha256(json.dumps(versions, sort_keys=True).encode()).hexdigest()
+
+
+def _disk_spec(func, compile_options, compile_fn):
+    import hashlib
+    import json
+
+    from flashinfer.jit.cute_dsl_core import JitSpecCuteDsl, cute_dsl_cache_disabled
+
+    if (
+        cute_dsl_cache_disabled()
+        or not type(func).__module__.startswith("flashinfer.gdn_kernels.")
+        or not _has_option_value(compile_options, cute.EnableTVMFFI, True)
+    ):
+        return None
+    try:
+        key = (func._get_compile_key(), _compile_options_key(compile_options))
+        digest = hashlib.sha256(
+            json.dumps(_disk_key_value(key), separators=(",", ":")).encode()
+        ).hexdigest()
+        return JitSpecCuteDsl(
+            "gdn_explicit_key_v1", digest, compile_fn, _disk_source_hash()
+        )
+    except (TypeError, OSError) as error:
+        warnings.warn(f"GDN persistent cache bypassed: {error}", RuntimeWarning)
+        return None
+
