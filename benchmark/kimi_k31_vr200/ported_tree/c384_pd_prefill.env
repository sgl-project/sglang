# c=384 point (prefill/decode disaggregated: 2 prefill workers TP8, 1 decode worker TP16 with attention DP 2; the
# c=400 form with the HT decode bundle on), prefill worker: common.env plus the keys below.
# Shortest-first in-batch prefix dedupe under --schedule-policy shortest-prefill-first: ungated in the served tree.
SGLANG_SPF_SHORTEST_FIRST_DEDUPE=1
# The draft model's layout must match the decode worker's (the PD handshake refuses a mismatch).
K31HT_DRAFT_DCP1=1
