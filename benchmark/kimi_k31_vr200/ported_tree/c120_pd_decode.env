# c=120 point (prefill/decode disaggregated: 1 prefill worker TP8, 3 decode workers TP8; release image), decode worker:
# common.env plus the keys below (the decode keys of the c=114 point).
# The served small-M GEMM table, at its place in this tree's image.
SGLANG_K31_SM107_SMALLM_TABLE=/sgl-workspace/sglang/benchmark/kimi_k31_vr200/sm107_tables/smallm_table_vr200_tp8_fold.json
# KDA replay fold block size, as served.
SGLANG_OPT_KDA_REPLAYSSM_FOLD_BLOCK_V=16
