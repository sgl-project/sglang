# Kimi-K3.1 VR200 points served on the day-0 and later images run on this tree: keys every worker (prefill and decode) sets ON
# TOP of the point's served launch environment, so that this tree runs the code paths the served host trees ran.
# Served keys that this tree does not read (SGLANG_K31_EVICT_BATCH_BACKUP, SGLANG_K31_MEGAMOE_LOCALIZE,
# SGLANG_K31_KDA_FOLD_BLOCK_V) may stay set; they do nothing.

# The c114 decode workers' served environment (day-0 image) sets SGLANG_K31_FUSED_ROUTING=1. #48414 removed that switch and
# runs its fused routing path without it. On this tree the key selects another dispatch (the K3.1 fused routing of the MID
# prefill, mr_tree/mid_pd_prefill.env), which these points did not run, so it is pinned off here. The c120 point, served on
# this tree's release image, left the key unset, which is the same value (off).
SGLANG_K31_FUSED_ROUTING=0

# A path this tree adds with default on; the served trees had none of it.
# Inline KV-destination publish on the PD decode worker under the overlap scheduler (no effect elsewhere).
SGLANG_ENABLE_DISAGG_DECODE_DEFERRED_PUBLISH=0

# The served base's default: rank 0 broadcasts every speculative decision to its TP group (this tree's default
# syncs only the startup probes).
SGLANG_SPEC_TP_SYNC=all

# Switches whose children change defaults on this tree; off in the served trees too (pinned).
SGLANG_ENABLE_NV_MEGA_RUNTIME_OPTIMIZATION=0
SGLANG_ENABLE_NV_MEGA_RUNTIME_K31_GB_OPTIMIZATION=0

# Image environment of the served images (written into the image, not into the launch configs); a container built
# from this tree's image recipe does not set them, so every worker sets them here.
NCCL_NVLS_ENABLE=0
SGLANG_ENABLE_TP_MEMORY_INBALANCE_CHECK=0
# Set by the prefill workers' own launch environment too (same value); the decode workers took it from the image.
CUDA_MODULE_LOADING=EAGER
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Load the Rust TreeCore extension built into the image; never invoke Cargo at server start.
SGLANG_RUST_BUILD_MODE=never

# Not set, because the served base has the same default:
#   SGLANG_K3_SHARDED_MOE, SGLANG_DFLASH_DRAFT_KV_RING           default on in both trees
#   SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND                       rust in both trees
#   SGLANG_ENABLE_DCP_PUSH_COMBINE                                the served SGLANG_DCP_PUSH_COMBINE, on in both
# The served images' other image-level keys (NCCL_CUMEM_ENABLE, NCCL_MNNVL_ENABLE, SGLANG_CUSTOM_ALL_REDUCE_V2_MAX_SIZE_KB,
# PYTORCH_ALLOC_CONF, SGLANG_ENABLE_PRIMS_TS_SM107, SGLANG_ENABLE_K3_SM107) are set by every worker's own launch
# environment; SGLANG_OPT_USE_CUSTOM_ALL_REDUCE_V2=1 is this tree's default.
