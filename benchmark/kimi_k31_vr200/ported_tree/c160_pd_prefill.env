# c=160 point (prefill/decode disaggregated: 1 prefill worker TP8, 3 decode workers TP8; release image), prefill worker:
# common.env plus the keys below.
# FlashInfer KDA prefill kernels on SM107 (off unless =1).
SGLANG_K31_KDA_PREFILL_FI_SM107=1
# Per-window DSA indexer logits (served on; read by the DSA indexer).
SGLANG_K31_DSA_PER_WINDOW_LOGITS=1
# Shortest-first in-batch prefix dedupe under --schedule-policy shortest-prefill-first.
SGLANG_SPF_SHORTEST_FIRST_DEDUPE=1
# Not set, because this tree has the same default: SGLANG_DSA_MQA_LOGITS_FREE_MEM_FRACTION (0.2, as served).
