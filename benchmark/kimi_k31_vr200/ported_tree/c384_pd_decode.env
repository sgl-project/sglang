# c=384 point (prefill/decode disaggregated: 2 prefill workers TP8, 1 decode worker TP16 with attention DP 2; the
# c=400 form with the HT decode bundle on), decode worker: common.env plus the keys below.
# Served as SGLANG_K31_MEGAMOE_LOCALIZE=1; this tree's key for the same MegaMoE weight localization.
SGLANG_OPT_DEEPGEMM_MEGA_MOE_LOCALIZE=1
# HT decode bundle, as served (every K31HT_* switch is off when unset).
K31HT_DRAFT_DCP1=1
K31HT_DRAFT_DCP1_TILE=1
K31HT_DRAFT_DENSE=1
K31HT_DRAFT_DENSE_IMPL=cute
K31HT_KDA_FOLD=tp4rm
K31HT_KDA_P1ILP=1
K31HT_MLA_PROFILE=br
K31HT_MLA_TAILROW=1
K31HT_DCP_COMBINE=v3
K31HT_DSA_SELECT=gvrmf
K31HT_SOFTMAX_SPLIT=1
K31HT_SAMP_SPLIT=1
K31HT_SAMP_SPARSEQ=1
K31HT_DRAFT_CTXKV_FUSE=1
K31HT_SEAM_COMMIT_FUSE=1
K31HT_IDX_FP8_1PASS=1
K31HT_DRAFT_TOPK_GATHER_PACK=1
K31HT_DRAFT_SITE_EPI=1
K31HT_DRAFT_AR_LEAN=256
# Served as K31HT_DSA_MERGE_PUSHC=1 (the DCP top-k merge pushes its candidates through shared memory, coalesced); this tree's
# staged merge variant has the same push, plus the own top-k stored after it and a register fallback for <= 2 failed ranks
# (same output).
SGLANG_K31_DCP_MERGE_STAGED=1
# Served with K31HT_IDX_DG_INCLUDE pointing at a separate sgl-deep-gemm 0.2.3.post2 header set, because the served image's
# DeepGEMM headers had moved. This tree vendors those DeepGEMM headers next to the one-pass kernel
# (python/sglang/srt/layers/attention/dsa/k31_dglogits/dg_include/), so no setting is needed.
