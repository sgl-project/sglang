# MID points c=40 and c=48 (prefill/decode disaggregated: 1 prefill worker TP8 with HiCache, 1 megakernel decode
# worker TP16), prefill worker: common.env plus the keys below. The MID points ran the same prefill words; their
# prefill args differ only in --hicache-size (180 / 210).

# Paths the served prefill tree ran by default, which this tree keeps default off.
SGLANG_K31_PREFILL_SP_TAIL=1
SGLANG_K3_SHARDED_MOE_FRONT=1
SGLANG_K3_AR_PUSH2=1
SGLANG_K3_AR_PUSH2_FINALIZE=1
SGLANG_K31_FUSED_ROUTING=1
SGLANG_OPT_DEEPGEMM_MEGA_MOE_RAISE_DECODE_BLOCK_M=1
SGLANG_DFLASH_GRAPH_POST_VERIFY=1
SGLANG_DFLASH_SHARD_DRAFT_FC=1
SGLANG_DISAGG_PREFILL_EAGER_RESULT_FIRST=1

# Paths the served prefill tree ran unconditionally, which this tree gates.
SGLANG_K3_SHARDED_LATENT_UP=1
SGLANG_K31_PF_NVFP4_ROUTE_QUANT=1
SGLANG_K31_PF_ATTN_RES_TILED=1
SGLANG_K31_PF_PREPARED_ROUTING=1
SGLANG_K31_PF_MOONCAKE_ROOM_SHARD=1
SGLANG_K31_PF_SPF_RESERVE_CHUNKED_TAIL=1
SGLANG_K31_PF_HICACHE_MAMBA_STATE_BYTES=1

# The served prefill's KDA prefill chain (segment-parallel h recurrence with 8 segments, pinned autotune lists, fused
# q / k / v prep, next-chunk prefetch in chunk_delta_h, 512-channel causal conv launch) and the multicast all-gather
# of the DSA indexer top-k (instead of NCCL). Same names and values as the served prefill environment.
SGLANG_K31_KDA_SEGSCAN=8
SGLANG_K31_KDA_TUNE_PIN=1
SGLANG_K31_KDA_QKV_PREP=1
SGLANG_K31_KDA_H_PREFETCH=1
SGLANG_K31_KDA_CONV_BLOCK_N=512
SGLANG_K31_PF_CUSTOM_AG=1

# The served prefill's SM107 decode-GEMM tactics and side-stream caps, through this tree's SM107 table switches.
SGLANG_K31_SM107_GEMM_TACTICS=1
SGLANG_K31_SM107_GEMM_TABLE=/sgl-workspace/sglang/benchmark/kimi_k31_vr200/sm107_tables/sm107_table_mid_prefill.json
SGLANG_K31_SM107_BFA_SIDE_MAX_TOKENS=288
SGLANG_K31_SM107_GATE_SIDE_MAX_TOKENS=288

# The served KDA replay records followed --mamba-ssm-dtype (float32); this tree's default is the activation dtype.
SGLANG_KDA_REPLAY_RECORD_DTYPE=float32

# The served launcher set these under their old names K31P_HCBUDGET / K31P_HCBUDGET_TRIM, which still work (with a
# deprecation warning).
SGLANG_K31_HICACHE_BUDGET=1
SGLANG_K31_HICACHE_BUDGET_TRIM=1

# Served words repeated because their defaults on this tree differ (common.env turns the K3.1 GB switch off).
SGLANG_K3_AR_FUSION=1
SGLANG_ENABLE_PRIMS_TS_SM107=1
SGLANG_OPT_USE_CUSTOM_ALL_REDUCE_V2=1
SGLANG_CUSTOM_ALL_REDUCE_V2_MAX_SIZE_KB=32768
# The served prefill left it unset (its default "all"); this tree's default resolves to "init" under common.env.
SGLANG_SPEC_TP_SYNC=all

# SGLANG_K31_PRIMS_TS_LISSUE (served u16) has no reader on this tree: Prims-TS is not used with the served trtllm DSA
# backends. Leave it out of the served words (inert if kept).
