# Kimi-K3.1 VR200 points on this tree: keys every worker (aggregated, prefill and decode) sets ON TOP of the
# point's served launch environment, so that this tree (the served host changes ported onto #48414) runs the
# code paths the served host trees ran. Keys only; no values here depend on the point.

# Paths this tree adds with default on; the served trees had none of them.
# Replicated MoE front (the sharded front can engage on any role with SGLANG_K3_AR_FUSION=1 and TP > 1).
SGLANG_K3_SHARDED_MOE=0
# Compact DFLASH draft KV table. The draft-KV ring already resolves to off on these points, because their launch
# words set --speculative-draft-window-size; pinned so a recipe without that flag cannot turn it on.
SGLANG_DFLASH_DRAFT_KV_RING=0
# Inline KV-destination publish on the PD decode worker under the overlap scheduler (no effect elsewhere).
SGLANG_ENABLE_DISAGG_DECODE_DEFERRED_PUBLISH=0

# Switches whose children change defaults on this tree (all off in the served trees, which lack them).
SGLANG_ENABLE_NV_MEGA_RUNTIME_OPTIMIZATION=0
SGLANG_ENABLE_NV_MEGA_RUNTIME_K31_GB_OPTIMIZATION=0

# Already set by every served environment; repeated because this tree's defaults are rust / auto.
SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND=python
SGLANG_RUST_BUILD_MODE=never

# Default-on keys of this tree left unset because they cannot engage on these points:
#   SGLANG_K31_DECODE_GEMM_TACTICS        applies only on device SM 103
#   SGLANG_ENABLE_DCP_PUSH_COMBINE        decode context parallelism only (these points run DCP size 1)
#   SGLANG_ENABLE_NV_MEGA_PDDEC_RUNTIME_OPTIMIZATION  acts only with SGLANG_ENABLE_NV_MEGA_RUNTIME_OPTIMIZATION=1
#   SGLANG_TOPK_V2_MODE=1                 exact top-k, the same contract as the served DSA top-k (the kernel is #48414's)
