# Configuration for the sglang-v100 systemd unit. Install at /etc/sglang-v100.env.
#
# Every path here is a placeholder -- change them to match your install.
#
# Pinning the venv and the model here rather than relying on a shell's cwd is
# the point of this file: the serve script derives its repo root from its own
# location, so running the copy in a stale checkout silently serves stale code
# against whichever venv happens to be active.

# 'mtp' enables the built-in MTP draft head (recommended). 'target' disables
# speculation.
SGLANG_V100_MODE=mtp

# Absolute path to the venv built per docs/v100/INSTALL.md.
SGLANG_V100_VENV=/opt/sglang-v100-venv

# The NVFP4 checkout (see the README's "Get the model").
FLASH_NEXT_MODEL=/opt/models/Qwen3.8-Flash-Next-NVFP4

# Shared bind for every V100 model (Qwen and DSV41). One engine at a time.
SGLANG_V100_HOST=0.0.0.0
SGLANG_V100_PORT=11435
FLASH_NEXT_HOST=0.0.0.0
FLASH_NEXT_PORT=11435
FLASH_NEXT_GPUS=0,1,2,3

# Host-RAM cache tier, in GB. The dominant term in host memory use; turn it
# down on a smaller box.
FLASH_NEXT_HICACHE=8

# L3 spill directory for the hierarchical cache's file backend. Must be
# writable by the service account. Without it the backend uses a temp path, so
# the disk tier is cold after every restart.
SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR=/var/cache/sglang-v100/hicache

# BOUND THE SPILL DIRECTORY. LRU eviction for the file backend is opt-in, and
# with both limits unset the tier grows without limit: on the reference box it
# reached 214 GB and took the filesystem to 97% full. Set at least one.
#   MAX_SIZE        caps the cache itself.
#   MIN_FREE_SPACE  caps it relative to the disk, which is the one that matters
#                   when models or other trees share the filesystem and grow
#                   underneath it.
# Either limit tripping evicts least-recently-used entries down to
# EVICTION_RATIO (default 0.9) of the cap. Sizes take SI/IEC suffixes; "0"
# disables that limit. Values below suit a ~1.6 TB disk -- scale to yours.
SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE=150G
SGLANG_HICACHE_FILE_BACKEND_MIN_FREE_SPACE=100G
