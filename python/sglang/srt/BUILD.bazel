load("@rules_python//python:defs.bzl", "py_library")
load("@runtime_import//:requirements.bzl", "requirement")
load("//bazel/packaging:source_glob.bzl", "pep517_source_glob")

package(default_visibility = ["//python/sglang:__subpackages__"])

filegroup(
    name = "main_wheel_pep517_sources",
    srcs = pep517_source_glob(["**"]) + [
        "//python/sglang/srt/rust_extensions:main_wheel_pep517_sources",
        "//python/sglang/srt/utils:main_wheel_pep517_sources",
        "//python/sglang/srt/weight_cache:main_wheel_pep517_sources",
    ],
    visibility = ["//visibility:public"],
)

# Keep the first SRT boundary deliberately small. environ.py is loaded before
# torch in production and must remain usable in torch-free configurations.
py_library(
    name = "environ",
    srcs = ["environ.py"],
    imports = ["../.."],
    visibility = [
        "//bazel/python:__subpackages__",
        "//python/sglang:__subpackages__",
    ],
)

# These function-call data/format modules are leaves in the first-party import
# graph. Keep them separate so their unit tests do not depend on all SRT sources.
py_library(
    name = "function_call_core_types",
    srcs = ["function_call/core_types.py"],
    imports = ["../.."],
    visibility = [
        "//bazel/python:__subpackages__",
        "//python/sglang:__subpackages__",
    ],
    deps = [requirement("pydantic")],
)

py_library(
    name = "function_call_kimik3_format",
    srcs = ["function_call/kimik3_format.py"],
    imports = ["../.."],
    visibility = [
        "//bazel/python:__subpackages__",
        "//python/sglang:__subpackages__",
    ],
)

py_library(
    name = "function_call_muse_glimmer_format",
    srcs = ["function_call/muse_glimmer_format.py"],
    imports = ["../.."],
    visibility = [
        "//bazel/python:__subpackages__",
        "//python/sglang:__subpackages__",
    ],
)

py_library(
    name = "runtime_sources",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "**/*_test.py",
            "**/test_*.py",
            "**/tests/**",
            "environ.py",
            "function_call/core_types.py",
            "function_call/kimik3_format.py",
            "function_call/muse_glimmer_format.py",
        ],
    ),
    data = glob(
        [
            "**/*.c",
            "**/*.cc",
            "**/*.cpp",
            "**/*.cu",
            "**/*.cuh",
            "**/*.h",
            "**/*.hpp",
            "**/*.jinja",
            "**/*.jinja2",
            "**/*.json",
            "**/*.txt",
            "**/*.yaml",
            "**/*.yml",
        ],
        allow_empty = True,
        exclude = ["**/tests/**"],
    ),
    imports = ["../.."],
    deps = [
        ":environ",
        ":function_call_core_types",
        ":function_call_kimik3_format",
        ":function_call_muse_glimmer_format",
        "//python/sglang/srt/rust_extensions:runtime_sources",
        "//python/sglang/srt/utils:runtime_sources",
        "//python/sglang/srt/utils/hf_transformers:runtime_sources",
        "//python/sglang/srt/weight_cache:runtime_sources",
    ],
)
