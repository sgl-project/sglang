load("@rules_python//python:defs.bzl", "py_library")
load("//bazel/packaging:source_glob.bzl", "pep517_source_glob")

package(default_visibility = ["//python/sglang:__subpackages__"])

filegroup(
    name = "main_wheel_pep517_sources",
    srcs = pep517_source_glob(["**"]) + [
        "//python/sglang/srt/utils/hf_transformers:main_wheel_pep517_sources",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "safe_pickle",
    srcs = ["safe_pickle.py"],
    imports = ["../../.."],
    visibility = [
        "//bazel/python:__subpackages__",
        "//python/sglang:__subpackages__",
    ],
)

py_library(
    name = "hf_transformers_patches",
    srcs = ["hf_transformers_patches.py"],
    imports = ["../../.."],
    visibility = [
        "//bazel/python:__subpackages__",
        "//python/sglang:__subpackages__",
    ],
    deps = ["//python/sglang/srt:environ"],
)

py_library(
    name = "runtime_sources",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "**/*_test.py",
            "**/test_*.py",
            "**/tests/**",
            "hf_transformers_patches.py",
            "safe_pickle.py",
        ],
    ),
    imports = ["../../.."],
    deps = [
        ":hf_transformers_patches",
        ":safe_pickle",
    ],
)
