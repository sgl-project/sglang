load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_library")
load("@srt_empty_bootstrap//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:private"])

# Torch-free metadata/dispatch layer. Native AOT and JIT implementations are
# separate targets so a CPU analysis does not select a CUDA or ROCm toolchain.
py_library(
    name = "metadata",
    srcs = [
        "registry.py",
        "selector.py",
        "spec.py",
    ],
    imports = ["../.."],
    visibility = [
        "//bazel/python:__subpackages__",
        "//python/sglang:__subpackages__",
    ],
    deps = [requirement("msgspec")],
)

# Python/JIT side of the installed sglang.kernels package.  The AOT
# sgl_kernel extension is a separate wheel and is intentionally not folded
# into this source target.
py_library(
    name = "runtime_sources",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "**/*_test.py",
            "**/benchmark/**",
            "**/test_*.py",
            "**/tests/**",
        ],
    ),
    data = glob(
        [
            "jit/**",
            "ops/**",
        ],
        allow_empty = True,
        exclude = [
            "**/*.py",
            "**/benchmark/**",
            "**/tests/**",
        ],
    ),
    imports = ["../.."],
    visibility = ["//python/sglang:__pkg__"],
)

# Host-only core of the speculative n-gram corpus. The TVM-FFI adapter remains
# a separate future target, so this compiles without torch, CUDA, or DLPack.
cc_library(
    name = "ngram_corpus_core",
    srcs = [
        "jit/csrc/ngram_corpus/ngram.cpp",
        "jit/csrc/ngram_corpus/result.cpp",
        "jit/csrc/ngram_corpus/suffix_automaton.cpp",
        "jit/csrc/ngram_corpus/trie.cpp",
    ],
    hdrs = [
        "jit/csrc/ngram_corpus/ngram.h",
        "jit/csrc/ngram_corpus/param.h",
        "jit/csrc/ngram_corpus/queue.h",
        "jit/csrc/ngram_corpus/result.h",
        "jit/csrc/ngram_corpus/suffix_automaton.h",
        "jit/csrc/ngram_corpus/trie.h",
    ],
    copts = ["-std=c++20"],
    linkopts = ["-pthread"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "jit_host_headers",
    hdrs = glob(["jit/include/**/*.h"]),
    includes = ["jit/include"],
    deps = ["@tvm_ffi_linux_x86_64//:tvm_ffi"],
)

cc_binary(
    name = "ngram_corpus_ffi.so",
    srcs = ["jit/csrc/ngram_corpus/ngram_corpus_ffi.cpp"],
    copts = [
        "-O3",
        "-std=c++20",
        "-fvisibility=hidden",
    ],
    linkshared = True,
    linkstatic = True,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":jit_host_headers",
        ":ngram_corpus_core",
        "@tvm_ffi_linux_x86_64//:tvm_ffi",
    ],
)

filegroup(
    name = "jit_sources",
    srcs = glob(
        [
            "jit/**/*.cc",
            "jit/**/*.cpp",
            "jit/**/*.cu",
            "jit/**/*.cuh",
            "jit/**/*.h",
            "jit/**/*.hpp",
            "jit/**/*.py",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
