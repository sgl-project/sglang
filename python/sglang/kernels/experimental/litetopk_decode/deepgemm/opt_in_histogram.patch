diff --git a/deep_gemm/include/deep_gemm/epilogue/coarse_histogram.cuh b/deep_gemm/include/deep_gemm/epilogue/coarse_histogram.cuh
new file mode 100644
index 0000000..3610b55
--- /dev/null
+++ b/deep_gemm/include/deep_gemm/epilogue/coarse_histogram.cuh
@@ -0,0 +1,75 @@
+#pragma once
+
+#include <cuda_fp16.h>
+#include <cutlass/arch/barrier.h>
+
+namespace deep_gemm::epilogue {
+
+// Empty default policy: no storage, initialization, cleanup or runtime branch.
+struct NoHistogram {
+    static constexpr bool kEnabled = false;
+};
+
+template <uint32_t kBins, uint32_t kMathThreads>
+__device__ __noinline__ void flush_coarse_histogram(int* local, int* global, int row) {
+    cutlass::arch::NamedBarrier(kMathThreads, 1).sync();
+    if (row >= 0) {
+        for (uint32_t bin = threadIdx.x; bin < kBins; bin += kMathThreads) {
+            const int count = local[bin];
+            if (count != 0) {
+                atomicAdd(global + static_cast<uint64_t>(row) * kBins + bin, count);
+                local[bin] = 0;
+            }
+        }
+    }
+    cutlass::arch::NamedBarrier(kMathThreads, 1).sync();
+}
+
+// Counts only live non-NaN scores. Caller owns zero-at-entry/consumer-reset of global bins.
+template <uint32_t kBins, uint32_t kMathThreads>
+struct CoarseHistogram {
+    static constexpr bool kEnabled = true;
+    static_assert(kBins == 1024);
+    int* global;
+    const uint32_t* lengths;
+    uint32_t logits_stride;
+    int* local = nullptr;
+    int current_row = -1;
+    uint32_t current_length = 0;
+
+    CUTLASS_DEVICE void initialize(int* scratch, uint32_t math_thread_idx) {
+        local = scratch;
+        for (uint32_t bin = math_thread_idx; bin < kBins; bin += kMathThreads)
+            local[bin] = 0;
+        cutlass::arch::NamedBarrier(kMathThreads, 1).sync();
+    }
+
+    CUTLASS_DEVICE void observe(uint32_t row, uint32_t column, float score) {
+        // All math threads visit the same row, including masked tail lanes.
+        if (static_cast<int>(row) != current_row) {
+            flush_coarse_histogram<kBins, kMathThreads>(local, global, current_row);
+            current_row = static_cast<int>(row);
+            current_length = lengths[row];
+        }
+        if (column < current_length && column < logits_stride && !isnan(score)) {
+            // Preserve exact FP16-RN bins below the boundary near 16.
+            // Code 304 joins that boundary to 17; later bins have width one.
+            const uint32_t bits = __float_as_uint(score);
+            uint32_t magnitude = bits & 0x7fffffffu;
+            const bool negative = (bits >> 31) && magnitude != 0;
+            int code = (__half_as_ushort(__float2half_rn(score)) & 0x7fffu) >> 6;
+            if (code >= 304) {
+                magnitude -= negative;  // lower-inclusive negative unit bins
+                const float bounded = __uint_as_float(min(magnitude, 0x435f0000u));
+                code = max(304, __float2int_rd(bounded) + 288);
+            }
+            atomicAdd(local + (negative ? 512 + code : 511 - code), 1);
+        }
+    }
+
+    CUTLASS_DEVICE void finish() {
+        flush_coarse_histogram<kBins, kMathThreads>(local, global, current_row);
+    }
+};
+
+}  // namespace deep_gemm::epilogue
