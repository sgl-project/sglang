+// dst may hold GGML_TYPE_F32, GGML_TYPE_F16 or GGML_TYPE_BF16 values (dst_type). The float sums are rounded
+// to nearest even once, when stored; partial sums of the stream-k fixup stay in fp32.
+static __device__ __forceinline__ float * ggml_cuda_mmq_dst_offset(float * dst, const int64_t offset, const ggml_type dst_type) {
+    return dst_type == GGML_TYPE_F32 ? dst + offset : (float *) ((char *) dst + offset*2);
+}
+
+static __device__ __forceinline__ void ggml_cuda_mmq_store(float * dst, const int64_t i, const float v, const ggml_type dst_type) {
+    if (dst_type == GGML_TYPE_F32) {
+        dst[i] = v;
+    } else {
+        ((unsigned short *) dst)[i] = dst_type == GGML_TYPE_BF16 ? __bfloat16_as_ushort(__float2bfloat16_rn(v))
+                                                                : __half_as_ushort(__float2half_rn(v));
+    }
+}
