package(default_visibility = ["//visibility:public"])

filegroup(
    name = "public_headers",
    srcs = glob(
        [
            "include/**/*.h",
            "include/**/*.hpp",
            "include/**/*.cuh",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "cpu_sources",
    srcs = glob(
        [
            "csrc/cpu/**/*.cc",
            "csrc/cpu/**/*.cpp",
            "csrc/cpu/**/*.h",
            "csrc/cpu/**/*.hpp",
        ],
        allow_empty = True,
    ),
    target_compatible_with = ["//bazel/platforms:cpu"],
)

filegroup(
    name = "cuda_sources",
    srcs = glob(
        [
            "cmake/**/*.cmake",
            "csrc/**/*.cc",
            "csrc/**/*.cpp",
            "csrc/**/*.cu",
            "csrc/**/*.cuh",
            "csrc/**/*.h",
            "csrc/**/*.hpp",
        ],
        allow_empty = True,
        exclude = [
            "csrc/cpu/**",
            "csrc/metal/**",
            "csrc/musa/**",
        ],
    ),
    target_compatible_with = ["//bazel/platforms:cuda"],
)

filegroup(
    name = "rocm_sources",
    srcs = glob(
        [
            "csrc/**/*.hip",
            "csrc/**/*.h",
            "csrc/**/*.hpp",
            "setup_rocm.py",
        ],
        allow_empty = True,
    ),
    target_compatible_with = ["//bazel/platforms:rocm"],
)

filegroup(
    name = "musa_sources",
    srcs = glob(
        [
            "csrc/musa/**",
            "setup_musa.py",
        ],
        allow_empty = True,
    ),
    target_compatible_with = ["//bazel/platforms:musa"],
)

filegroup(
    name = "python_facade",
    srcs = glob(
        ["python/sgl_kernel/**/*.py"],
        allow_empty = True,
    ),
)

filegroup(
    name = "build_metadata",
    srcs = [
        "CMakeLists.txt",
        "pyproject.toml",
        "pyproject_cpu.toml",
        "pyproject_musa.toml",
        "pyproject_rocm.toml",
    ],
)
