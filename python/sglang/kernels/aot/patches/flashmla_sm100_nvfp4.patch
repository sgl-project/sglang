+__device__ __forceinline__ half nvfp4_e4m3_scale_to_half(uint8_t code) {
+    const uint16_t packed = uint16_t(code) | (uint16_t(code) << 8);
+    uint32_t fp16x2;
+    asm volatile(
+        "cvt.rn.f16x2.e4m3x2 %0, %1;\n"
+        : "=r"(fp16x2)
+        : "h"(packed));
+    return *reinterpret_cast<const half*>(&fp16x2);
+}
