--- pristine/csrc/sm90/decode/sparse_fp8/components/shared_demand_cache.h	1970-01-01 08:00:00
+++ desired/csrc/sm90/decode/sparse_fp8/components/shared_demand_cache.h	2026-08-11 20:00:19
@@ -0,0 +1,221 @@
+#pragma once
+
+#include <cstdint>
+
+namespace flashmla::shared_demand_cache {
+
+static constexpr int ROW_BYTES = 584;
+static constexpr int ROW_STRIDE = 592;
+static constexpr int MAX_WAYS = 4;
+static constexpr int DIRECT_MIN_ROWS = 1 << 18;
+static constexpr uint64_t READY_BIT = 1ull << 63;
+
+enum class Access : int {
+    DIRECT = 0,
+    HIT = 1,
+    FILL = 2,
+    COLLISION = 3,
+    FILLING = 4,
+};
+
+struct ProbeResult {
+    int slot;
+    Access access;
+};
+
+static __forceinline__ __device__ uint64_t load_acquire(const uint64_t* ptr) {
+    uint64_t value;
+    asm volatile(
+        "ld.global.acquire.gpu.u64 %0, [%1];"
+        : "=l"(value)
+        : "l"(ptr)
+        : "memory"
+    );
+    return value;
+}
+
+static __forceinline__ __device__ uint64_t compare_exchange_acq_rel(
+    uint64_t* ptr, uint64_t expected, uint64_t desired
+) {
+    uint64_t old;
+    asm volatile(
+        "atom.global.acq_rel.gpu.cas.b64 %0, [%1], %2, %3;"
+        : "=l"(old)
+        : "l"(ptr), "l"(expected), "l"(desired)
+        : "memory"
+    );
+    return old;
+}
+
+static __forceinline__ __device__ void store_release(
+    uint64_t* ptr, uint64_t value
+) {
+    asm volatile(
+        "st.global.release.gpu.u64 [%0], %1;"
+        :
+        : "l"(ptr), "l"(value)
+        : "memory"
+    );
+}
+
+static __forceinline__ __device__ uint64_t filling_tag(
+    uint32_t epoch, uint32_t family, uint32_t physical_row
+) {
+    return (static_cast<uint64_t>(epoch) << 32) |
+           (static_cast<uint64_t>(family) << 31) |
+           (static_cast<uint64_t>(physical_row) + 1);
+}
+
+static __forceinline__ __device__ ProbeResult probe(
+    uint64_t* tags,
+    int num_sets,
+    int ways,
+    uint32_t epoch,
+    uint32_t family,
+    uint32_t physical_row
+) {
+    const uint64_t filling = filling_tag(epoch, family, physical_row);
+    const uint64_t ready = filling | READY_BIT;
+    const uint32_t set = (physical_row ^ (physical_row >> 13) ^
+                          (family * 0x9e3779b9u)) &
+                         static_cast<uint32_t>(num_sets - 1);
+    uint64_t* set_tags = tags + set * ways;
+    int candidate = -1;
+    uint64_t candidate_tag = 0;
+
+    #pragma unroll
+    for (int way = 0; way < MAX_WAYS; ++way) {
+        if (way >= ways) break;
+        const uint64_t observed = load_acquire(set_tags + way);
+        if (observed == ready) return {static_cast<int>(set * ways + way), Access::HIT};
+        if (observed == filling) return {-1, Access::FILLING};
+        const uint32_t observed_epoch =
+            static_cast<uint32_t>((observed & ~READY_BIT) >> 32);
+        if (candidate < 0 && observed_epoch != epoch) {
+            candidate = way;
+            candidate_tag = observed;
+        }
+    }
+
+    if (candidate >= 0) {
+        const uint64_t old = compare_exchange_acq_rel(
+            set_tags + candidate, candidate_tag, filling
+        );
+        if (old == candidate_tag) {
+            return {static_cast<int>(set * ways + candidate), Access::FILL};
+        }
+        if (old == ready) {
+            return {static_cast<int>(set * ways + candidate), Access::HIT};
+        }
+        if (old == filling) return {-1, Access::FILLING};
+    }
+    return {-1, Access::COLLISION};
+}
+
+static __forceinline__ __device__ uint32_t load_direct_acquire(
+    const uint64_t* tags, int slot
+) {
+    uint32_t value;
+    const uint32_t* ptr = reinterpret_cast<const uint32_t*>(tags) + slot;
+    asm volatile(
+        "ld.global.acquire.gpu.u32 %0, [%1];"
+        : "=r"(value)
+        : "l"(ptr)
+        : "memory"
+    );
+    return value;
+}
+
+static __forceinline__ __device__ uint32_t compare_exchange_direct_relaxed(
+    uint64_t* tags, int slot, uint32_t expected, uint32_t desired
+) {
+    uint32_t old;
+    uint32_t* ptr = reinterpret_cast<uint32_t*>(tags) + slot;
+    asm volatile(
+        "atom.global.relaxed.gpu.cas.b32 %0, [%1], %2, %3;"
+        : "=r"(old)
+        : "l"(ptr), "r"(expected), "r"(desired)
+        : "memory"
+    );
+    return old;
+}
+
+static __forceinline__ __device__ void store_direct_release(
+    uint64_t* tags, int slot, uint32_t value
+) {
+    uint32_t* ptr = reinterpret_cast<uint32_t*>(tags) + slot;
+    asm volatile(
+        "st.global.release.gpu.u32 [%0], %1;"
+        :
+        : "l"(ptr), "r"(value)
+        : "memory"
+    );
+}
+
+static __forceinline__ __device__ ProbeResult probe_direct(
+    uint64_t* tags,
+    int num_rows,
+    uint32_t epoch,
+    uint32_t family,
+    uint32_t logical_row
+) {
+    const uint32_t rows_per_family = static_cast<uint32_t>(num_rows >> 1);
+    if (logical_row >= rows_per_family) return {-1, Access::DIRECT};
+    const int slot = static_cast<int>(family * rows_per_family + logical_row);
+    const uint32_t filling = epoch << 1;
+    const uint32_t ready = filling | 1u;
+    const uint32_t observed = load_direct_acquire(tags, slot);
+    if (observed == ready) return {slot, Access::HIT};
+    if (observed == filling) return {slot, Access::FILLING};
+    const uint32_t old = compare_exchange_direct_relaxed(
+        tags, slot, observed, filling
+    );
+    if (old == observed) return {slot, Access::FILL};
+    if (old == ready) return {slot, Access::HIT};
+    if (old == filling) return {slot, Access::FILLING};
+    return {-1, Access::COLLISION};
+}
+
+static __forceinline__ __device__ void publish_ready(
+    uint64_t* tags,
+    int slot,
+    uint32_t epoch,
+    uint32_t family,
+    uint32_t physical_row
+) {
+    store_release(
+        tags + slot,
+        filling_tag(epoch, family, physical_row) | READY_BIT
+    );
+}
+
+static __forceinline__ __device__ void publish_ready_direct(
+    uint64_t* tags, int slot, uint32_t epoch
+) {
+    store_direct_release(tags, slot, (epoch << 1) | 1u);
+}
+
+static __forceinline__ __device__ void wait_ready_direct(
+    const uint64_t* tags, int slot, uint32_t epoch
+) {
+    const uint32_t ready = (epoch << 1) | 1u;
+    while (load_direct_acquire(tags, slot) != ready) {}
+}
+
+static __forceinline__ __device__ void fence_async_global() {
+    asm volatile("fence.proxy.async.global;" ::: "memory");
+}
+
+static __forceinline__ __device__ void count(
+    uint64_t* stats, Access access
+) {
+    if (stats != nullptr) {
+        atomicAdd(
+            reinterpret_cast<unsigned long long*>(stats) +
+                static_cast<int>(access),
+            1ull
+        );
+    }
+}
+
+}  // namespace flashmla::shared_demand_cache
