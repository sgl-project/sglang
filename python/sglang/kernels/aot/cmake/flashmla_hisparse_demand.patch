@@ -0,0 +1,117 @@
+#pragma once
+
+#include <cstdint>
+
+namespace sm90::decode::sparse_fp8::hisparse_demand_source {
+
+static constexpr int ROW_BYTES = 656;
+static constexpr uint32_t GENERATION_MASK = (1u << 24) - 1;
+static constexpr uint32_t TAG_GENERATION_SHIFT = 2;
+static constexpr uint32_t TAG_ROW_SHIFT = 26;
+static constexpr uint32_t RETENTION_STEPS = 2;
+
+enum class State : uint32_t { FILLING = 1, READY = 2 };
+
+static __forceinline__ __device__ uint64_t pack_tag(
+    uint32_t generation,
+    State state,
+    uint64_t host_row
+) {
+    return (host_row << TAG_ROW_SHIFT) |
+        (static_cast<uint64_t>(generation & GENERATION_MASK)
+         << TAG_GENERATION_SHIFT) |
+        static_cast<uint64_t>(state);
+}
+
+static __forceinline__ __device__ uint32_t tag_generation(uint64_t value) {
+    return static_cast<uint32_t>(
+        (value >> TAG_GENERATION_SHIFT) & GENERATION_MASK
+    );
+}
+
+static __forceinline__ __device__ uint64_t tag_row(uint64_t value) {
+    return value >> TAG_ROW_SHIFT;
+}
+
+static __forceinline__ __device__ State tag_state(uint64_t value) {
+    return static_cast<State>(value & 0x3ull);
+}
+
+static __forceinline__ __device__ bool is_ready_row(
+    uint64_t value,
+    uint64_t host_row
+) {
+    return tag_state(value) == State::READY && tag_row(value) == host_row;
+}
+
+static __forceinline__ __device__ bool is_filling_row(
+    uint64_t value,
+    uint32_t generation,
+    uint64_t host_row
+) {
+    return tag_state(value) == State::FILLING &&
+        tag_generation(value) == generation && tag_row(value) == host_row;
+}
+
+static __forceinline__ __device__ bool is_replaceable(
+    uint64_t value,
+    uint32_t generation
+) {
+    const uint32_t age =
+        (generation - tag_generation(value)) & GENERATION_MASK;
+    return value == 0 ||
+        (tag_state(value) == State::READY && age >= RETENTION_STEPS);
+}
+
+static __forceinline__ __device__ uint64_t load_acquire(
+    const uint64_t* ptr
+) {
+    uint64_t value;
+    asm volatile(
+        "ld.global.acquire.gpu.u64 %0, [%1];"
+        : "=l"(value)
+        : "l"(ptr)
+        : "memory"
+    );
+    return value;
+}
+
+static __forceinline__ __device__ uint64_t compare_exchange_acq_rel(
+    uint64_t* ptr,
+    uint64_t expected,
+    uint64_t desired
+) {
+    uint64_t old;
+    asm volatile(
+        "atom.global.acq_rel.gpu.cas.b64 %0, [%1], %2, %3;"
+        : "=l"(old)
+        : "l"(ptr), "l"(expected), "l"(desired)
+        : "memory"
+    );
+    return old;
+}
+
+static __forceinline__ __device__ void store_release(
+    uint64_t* ptr,
+    uint64_t value
+) {
+    asm volatile(
+        "st.global.release.gpu.u64 [%0], %1;"
+        :
+        : "l"(ptr), "l"(value)
+        : "memory"
+    );
+}
+
+static __forceinline__ __device__ bool observe_ready(
+    const uint64_t* ptr,
+    uint32_t generation,
+    uint64_t host_row
+) {
+    const uint64_t observed = load_acquire(ptr);
+    return tag_state(observed) == State::READY &&
+        tag_generation(observed) == generation &&
+        tag_row(observed) == host_row;
+}
+
+}  // namespace sm90::decode::sparse_fp8::hisparse_demand_source
