diff -ruN base/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_params.h final/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_params.h
--- base/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_params.h	1970-01-01 08:00:00
+++ final/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_params.h	2026-08-23 22:08:19
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdint>
+
+namespace sm90::decode::sparse_fp8::hisparse_demand {
+
+struct Params {
+    const uint8_t* __restrict__ host_kv = nullptr;
+    const int32_t* __restrict__ host_locs = nullptr;
+    const int64_t* __restrict__ device_locs = nullptr;
+    uint64_t* __restrict__ cache_tags = nullptr;
+    const int32_t* __restrict__ decode_calls = nullptr;
+    const int32_t* __restrict__ num_real_reqs = nullptr;
+    const int64_t* __restrict__ req_pool_indices = nullptr;
+    const int32_t* __restrict__ seq_lens = nullptr;
+    const int32_t* __restrict__ mtp_committed_lens = nullptr;
+    int cache_rows = 0;
+    int host_locs_req_stride = 0;
+    int device_locs_req_stride = 0;
+    int token_capacity = 0;
+    int cache_tags_req_stride = 0;
+    int cache_tags_slot_stride = 0;
+
+};
+
+}  // namespace sm90::decode::sparse_fp8::hisparse_demand
diff -ruN base/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_producer.h final/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_producer.h
--- base/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_producer.h	1970-01-01 08:00:00
+++ final/csrc/sm90/decode/sparse_fp8/components/hisparse_demand_producer.h	2026-08-23 22:08:19
@@ -0,0 +1,358 @@
+#pragma once
+
+#include <cstdint>
+
+#include "hisparse_demand_source.h"
+
+namespace sm90::decode::sparse_fp8::hisparse_demand_producer {
+
+namespace source = hisparse_demand_source;
+
+enum class Kind : int { INVALID = 0, DEVICE = 1, HOST = 2, FILL = 3 };
+
+struct Resolution {
+    Kind kind = Kind::INVALID;
+    int physical_row = -1;
+    int cache_slot = -1;
+    uint64_t* fill_tag = nullptr;
+    uint64_t fill_ready_tag = 0;
+};
+
+template <typename FP8>
+struct ThreadState {
+    FP8* source_row = nullptr;
+    uint8_t* fill_row = nullptr;
+    uint64_t* fill_tag = nullptr;
+    uint64_t fill_ready_tag = 0;
+};
+
+static __forceinline__ __device__ uint32_t primary_slot(
+    uint32_t row,
+    uint32_t mask
+) {
+    return ((row ^ (row >> 11)) * 0x9e3779b1u) & mask;
+}
+
+static __forceinline__ __device__ uint32_t secondary_slot(
+    uint32_t row,
+    uint32_t first,
+    uint32_t mask
+) {
+    uint32_t second = ((row ^ (row >> 16)) * 0x85ebca6bu) & mask;
+    return (second + static_cast<uint32_t>(second == first)) & mask;
+}
+
+static __forceinline__ __device__ bool promote_ready(
+    uint64_t* tag,
+    uint64_t observed,
+    uint32_t generation,
+    uint64_t row
+) {
+    if (!source::is_ready_row(observed, row)) return false;
+    if (source::tag_generation(observed) == generation) return true;
+    const uint64_t ready = source::pack_tag(
+        generation, source::State::READY, row
+    );
+    const uint64_t old = source::compare_exchange_acq_rel(
+        tag, observed, ready
+    );
+    return old == observed ||
+        (source::observe_ready(tag, generation, row));
+}
+
+static __forceinline__ __device__ Resolution resolve(
+    int logical_token,
+    int host_row,
+    int seq_len,
+    int committed_len,
+    int64_t request_slot,
+    uint64_t* cache_tags,
+    int64_t tag_request_stride,
+    int cache_rows,
+    const int64_t* device_locs,
+    int64_t device_request_stride,
+    const int32_t* decode_calls
+) {
+    Resolution result;
+    if (logical_token < 0 || logical_token >= seq_len) return result;
+
+    if (
+        logical_token >= committed_len &&
+        logical_token < committed_len + 4
+    ) {
+        result.kind = Kind::DEVICE;
+        result.physical_row = static_cast<int>(__ldg(
+            device_locs + request_slot * device_request_stride + cache_rows +
+            2 + logical_token - committed_len
+        ));
+        return result;
+    }
+    if (logical_token >= committed_len || host_row < 0) return result;
+
+    const int calls = __ldg(decode_calls + request_slot);
+    const uint32_t generation = static_cast<uint32_t>(
+        calls > 0 ? calls - 1 : 0
+    ) & source::GENERATION_MASK;
+    const uint64_t row = static_cast<uint32_t>(host_row);
+    const uint32_t mask = static_cast<uint32_t>(cache_rows - 1);
+    uint32_t slots[2] = {
+        primary_slot(static_cast<uint32_t>(row), mask), 0
+    };
+    slots[1] = secondary_slot(
+        static_cast<uint32_t>(row), slots[0], mask
+    );
+    const int64_t tag_base = request_slot * tag_request_stride;
+    uint64_t* tags[2] = {
+        cache_tags + tag_base + slots[0],
+        cache_tags + tag_base + slots[1]
+    };
+    uint64_t observed[2];
+
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        observed[i] = source::load_acquire(tags[i]);
+        if (promote_ready(tags[i], observed[i], generation, row)) {
+            result.kind = Kind::DEVICE;
+            result.cache_slot = static_cast<int>(slots[i]);
+            result.physical_row = static_cast<int>(__ldg(
+                device_locs + request_slot * device_request_stride + slots[i]
+            ));
+            return result;
+        }
+        observed[i] = source::load_acquire(tags[i]);
+        if (source::is_filling_row(observed[i], generation, row)) {
+            result.kind = source::observe_ready(tags[i], generation, row)
+                ? Kind::DEVICE
+                : Kind::HOST;
+            result.cache_slot = static_cast<int>(slots[i]);
+            if (result.kind == Kind::DEVICE) {
+                result.physical_row = static_cast<int>(__ldg(
+                    device_locs + request_slot * device_request_stride + slots[i]
+                ));
+            }
+            return result;
+        }
+    }
+
+    int target = -1;
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        if (observed[i] == 0 && target < 0) target = i;
+    }
+    if (target < 0) {
+        uint32_t oldest_age = 0;
+        #pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            if (!source::is_replaceable(observed[i], generation)) continue;
+            const uint32_t age =
+                (generation - source::tag_generation(observed[i])) &
+                source::GENERATION_MASK;
+            if (target < 0 || age > oldest_age) {
+                target = i;
+                oldest_age = age;
+            }
+        }
+    }
+
+    if (target >= 0) {
+        const uint64_t filling = source::pack_tag(
+            generation, source::State::FILLING, row
+        );
+        const uint64_t old = source::compare_exchange_acq_rel(
+            tags[target], observed[target], filling
+        );
+        if (old == observed[target]) {
+            result.kind = Kind::FILL;
+            result.cache_slot = static_cast<int>(slots[target]);
+            result.physical_row = static_cast<int>(__ldg(
+                device_locs + request_slot * device_request_stride +
+                slots[target]
+            ));
+            result.fill_tag = tags[target];
+            result.fill_ready_tag = source::pack_tag(
+                generation, source::State::READY, row
+            );
+            return result;
+        }
+    }
+
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        observed[i] = source::load_acquire(tags[i]);
+        if (promote_ready(tags[i], observed[i], generation, row) ||
+            source::observe_ready(tags[i], generation, row)) {
+            result.kind = Kind::DEVICE;
+            result.cache_slot = static_cast<int>(slots[i]);
+            result.physical_row = static_cast<int>(__ldg(
+                device_locs + request_slot * device_request_stride + slots[i]
+            ));
+            return result;
+        }
+    }
+    result.kind = Kind::HOST;
+    return result;
+}
+
+static __forceinline__ __device__ bool is_valid(
+    int logical_token,
+    int host_row,
+    int seq_len,
+    int committed_len
+) {
+    if (logical_token < 0 || logical_token >= seq_len) return false;
+    if (
+        logical_token >= committed_len &&
+        logical_token < committed_len + 4
+    ) {
+        return true;
+    }
+    return logical_token < committed_len && host_row >= 0;
+}
+
+template <typename Params, typename FP8>
+static __forceinline__ __device__ ThreadState<FP8> resolve_source(
+    const Params& params,
+    int batch_idx,
+    int topk_ordinal,
+    int lane_idx,
+    int page_block_size,
+    int64_t k_block_stride,
+    int64_t k_row_stride,
+    FP8* k_ptr,
+    int& token_index,
+    int& block_index,
+    int& rel_idx_in_block
+) {
+    ThreadState<FP8> state;
+    const auto& demand = params.hisparse_demand;
+    if (demand.host_kv == nullptr) {
+        state.source_row = k_ptr + block_index * k_block_stride +
+            rel_idx_in_block * k_row_stride;
+        return state;
+    }
+
+    const unsigned row_group_mask = 0x01010101u << (lane_idx % 8);
+    int source_kind = static_cast<int>(Kind::INVALID);
+    int host_row = -1;
+    int physical_row = -1;
+    if (
+        lane_idx < 8 && topk_ordinal >= 0 &&
+        topk_ordinal < demand.token_capacity &&
+        batch_idx < __ldg(demand.num_real_reqs)
+    ) {
+        host_row = __ldg(
+            demand.host_locs +
+            batch_idx * demand.host_locs_req_stride + topk_ordinal
+        );
+        const int64_t request_slot = __ldg(
+            demand.req_pool_indices + batch_idx
+        );
+        const auto resolution = resolve(
+            token_index,
+            host_row,
+            __ldg(demand.seq_lens + batch_idx),
+            __ldg(demand.mtp_committed_lens + batch_idx),
+            request_slot,
+            demand.cache_tags,
+            demand.cache_tags_req_stride,
+            demand.cache_rows,
+            demand.device_locs,
+            demand.device_locs_req_stride,
+            demand.decode_calls
+        );
+        source_kind = static_cast<int>(resolution.kind);
+        physical_row = resolution.physical_row;
+        if (resolution.kind == Kind::FILL) {
+            state.fill_tag = resolution.fill_tag;
+            state.fill_ready_tag = resolution.fill_ready_tag;
+        }
+    }
+    source_kind = __shfl_sync(
+        row_group_mask, source_kind, lane_idx % 8
+    );
+    host_row = __shfl_sync(row_group_mask, host_row, lane_idx % 8);
+    physical_row = __shfl_sync(
+        row_group_mask, physical_row, lane_idx % 8
+    );
+
+    auto get_device_row = [&](int row) {
+        const int physical_block = static_cast<uint32_t>(row) /
+            static_cast<uint32_t>(page_block_size);
+        const int physical_offset = static_cast<uint32_t>(row) %
+            static_cast<uint32_t>(page_block_size);
+        return k_ptr + physical_block * k_block_stride +
+            physical_offset * k_row_stride;
+    };
+
+    const auto kind = static_cast<Kind>(source_kind);
+    if (kind == Kind::DEVICE) {
+        token_index = physical_row;
+        block_index = static_cast<uint32_t>(token_index) /
+            static_cast<uint32_t>(page_block_size);
+        rel_idx_in_block = static_cast<uint32_t>(token_index) %
+            static_cast<uint32_t>(page_block_size);
+        state.source_row = get_device_row(physical_row);
+    } else if (kind == Kind::HOST || kind == Kind::FILL) {
+        state.source_row = reinterpret_cast<FP8*>(
+            const_cast<uint8_t*>(
+                demand.host_kv + host_row * source::ROW_BYTES
+            )
+        );
+        if (kind == Kind::FILL) {
+            state.fill_row = reinterpret_cast<uint8_t*>(
+                get_device_row(physical_row)
+            );
+        }
+    } else {
+        token_index = -1;
+        state.source_row = k_ptr;
+    }
+    return state;
+}
+
+template <typename Params>
+static __forceinline__ __device__ bool is_index_valid(
+    const Params& params,
+    int batch_idx,
+    int ordinal,
+    int logical_token
+) {
+    const auto& demand = params.hisparse_demand;
+    if (demand.host_kv == nullptr) return logical_token != -1;
+    if (batch_idx >= __ldg(demand.num_real_reqs)) return false;
+    const int host_row = __ldg(
+        demand.host_locs +
+        batch_idx * demand.host_locs_req_stride + ordinal
+    );
+    return is_valid(
+        logical_token,
+        host_row,
+        __ldg(demand.seq_lens + batch_idx),
+        __ldg(demand.mtp_committed_lens + batch_idx)
+    );
+}
+
+template <typename T>
+static __forceinline__ __device__ void maybe_fill(
+    uint8_t* fill_row,
+    int byte_offset,
+    const T& value
+) {
+    if (fill_row != nullptr) {
+        *reinterpret_cast<T*>(fill_row + byte_offset) = value;
+    }
+}
+
+static __forceinline__ __device__ void publish_fill(
+    uint8_t* fill_row,
+    uint64_t* fill_tag,
+    uint64_t fill_ready_tag,
+    int lane_idx
+) {
+    if (fill_row == nullptr) return;
+    const unsigned row_group_mask = 0x01010101u << (lane_idx % 8);
+    __syncwarp(row_group_mask);
+    if (lane_idx < 8) source::store_release(fill_tag, fill_ready_tag);
+}
+
+}  // namespace sm90::decode::sparse_fp8::hisparse_demand_producer
