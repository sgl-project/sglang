diff -ruN base/csrc/api/hisparse_demand.h final/csrc/api/hisparse_demand.h
--- base/csrc/api/hisparse_demand.h	1970-01-01 08:00:00
+++ final/csrc/api/hisparse_demand.h	2026-08-23 21:59:33
@@ -0,0 +1,151 @@
+#pragma once
+
+#include <optional>
+
+#include "../sm90/decode/sparse_fp8/components/hisparse_demand_params.h"
+
+struct HisparseDemandArgs {
+    std::optional<at::Tensor> host_kv;
+    std::optional<at::Tensor> host_locs;
+    std::optional<at::Tensor> device_locs;
+    std::optional<at::Tensor> cache_tags;
+    std::optional<at::Tensor> decode_calls;
+    std::optional<at::Tensor> num_real_reqs;
+    std::optional<at::Tensor> req_pool_indices;
+    std::optional<at::Tensor> seq_lens;
+    std::optional<at::Tensor> mtp_committed_lens;
+    int64_t cache_rows = 0;
+
+    bool enabled() const {
+        return host_kv.has_value();
+    }
+
+    void validate(
+        const Arch& arch,
+        const at::Tensor& kv,
+        int batch_size,
+        int query_length,
+        int head_dim,
+        int topk,
+        bool have_extra_kcache,
+        bool have_topk_length,
+        bool have_attn_sink
+    ) const {
+        const bool have_all =
+            host_kv.has_value() && host_locs.has_value() &&
+            device_locs.has_value() && cache_tags.has_value() &&
+            decode_calls.has_value() && num_real_reqs.has_value() &&
+            req_pool_indices.has_value() && seq_lens.has_value() &&
+            mtp_committed_lens.has_value();
+        const bool have_any =
+            host_kv.has_value() || host_locs.has_value() ||
+            device_locs.has_value() || cache_tags.has_value() ||
+            decode_calls.has_value() || num_real_reqs.has_value() ||
+            req_pool_indices.has_value() || seq_lens.has_value() ||
+            mtp_committed_lens.has_value();
+        TORCH_CHECK(
+            have_all || !have_any,
+            "all HiSparse Demand tensors must be provided together"
+        );
+        if (!have_all) {
+            TORCH_CHECK(
+                cache_rows == 0,
+                "cache_rows requires the HiSparse Demand tensor bundle"
+            );
+            return;
+        }
+
+        KU_CHECK_DEVICE(host_locs);
+        KU_CHECK_DEVICE(device_locs);
+        KU_CHECK_DEVICE(cache_tags);
+        KU_CHECK_DEVICE(decode_calls);
+        KU_CHECK_DEVICE(num_real_reqs);
+        KU_CHECK_DEVICE(req_pool_indices);
+        KU_CHECK_DEVICE(seq_lens);
+        KU_CHECK_DEVICE(mtp_committed_lens);
+
+        KU_CHECK_DTYPE(host_locs, torch::kInt32);
+        KU_CHECK_DTYPE(device_locs, torch::kInt64);
+        KU_CHECK_DTYPE(cache_tags, torch::kInt64);
+        KU_CHECK_DTYPE(decode_calls, torch::kInt32);
+        KU_CHECK_DTYPE(num_real_reqs, torch::kInt32);
+        KU_CHECK_DTYPE(req_pool_indices, torch::kInt64);
+        KU_CHECK_DTYPE(seq_lens, torch::kInt32);
+        KU_CHECK_DTYPE(mtp_committed_lens, torch::kInt32);
+
+        KU_CHECK_CONTIGUOUS(host_locs);
+        KU_CHECK_CONTIGUOUS(device_locs);
+        KU_CHECK_CONTIGUOUS(cache_tags);
+        KU_CHECK_CONTIGUOUS(decode_calls);
+        KU_CHECK_CONTIGUOUS(num_real_reqs);
+        KU_CHECK_CONTIGUOUS(req_pool_indices);
+        KU_CHECK_CONTIGUOUS(seq_lens);
+        KU_CHECK_CONTIGUOUS(mtp_committed_lens);
+
+        TORCH_CHECK(arch.is_sm90a(), "HiSparse Demand only supports SM90");
+        TORCH_CHECK(head_dim == 576, "HiSparse Demand only supports V32 KV rows");
+        TORCH_CHECK(query_length == 1, "HiSparse Demand requires s_q == 1");
+        TORCH_CHECK(topk == 2048, "HiSparse Demand requires topk == 2048");
+        TORCH_CHECK(cache_rows == 4096, "HiSparse Demand requires cache_rows == 4096");
+        TORCH_CHECK(!have_extra_kcache, "HiSparse Demand does not support extra KV");
+        TORCH_CHECK(!have_topk_length, "HiSparse Demand does not support topk_length");
+        TORCH_CHECK(!have_attn_sink, "HiSparse Demand does not support attn_sink");
+        TORCH_CHECK(host_kv->device().is_cpu(), "HiSparse Demand host KV must be on CPU");
+        TORCH_CHECK(host_kv->is_pinned(), "HiSparse Demand host KV must be pinned");
+        TORCH_CHECK(host_kv->is_contiguous(), "HiSparse Demand host KV must be contiguous");
+        TORCH_CHECK(
+            host_kv->scalar_type() == kv.scalar_type(),
+            "HiSparse Demand host KV dtype must match device KV"
+        );
+        TORCH_CHECK(
+            host_kv->element_size() == 1 && host_kv->size(-1) == 656,
+            "HiSparse Demand host KV must contain contiguous 656-byte rows"
+        );
+        TORCH_CHECK(
+            host_locs->dim() == 2 && host_locs->size(0) == batch_size &&
+                host_locs->size(1) == topk,
+            "HiSparse Demand host locations must have shape [batch, topk]"
+        );
+        TORCH_CHECK(
+            device_locs->dim() == 2 &&
+                device_locs->size(1) == cache_rows + 6,
+            "HiSparse MTP Demand device locations must have shape [request, cache_rows + 6]"
+        );
+        TORCH_CHECK(
+            cache_tags->dim() == 2 &&
+                cache_tags->size(0) == device_locs->size(0) &&
+                cache_tags->size(1) == cache_rows,
+            "HiSparse Demand cache tags must have shape [request, cache_rows]"
+        );
+        TORCH_CHECK(
+            decode_calls->dim() == 1 &&
+                decode_calls->size(0) == device_locs->size(0),
+            "HiSparse Demand decode calls must have shape [request]"
+        );
+        KU_CHECK_SHAPE(num_real_reqs, 1);
+        KU_CHECK_SHAPE(req_pool_indices, batch_size);
+        KU_CHECK_SHAPE(seq_lens, batch_size);
+        KU_CHECK_SHAPE(mtp_committed_lens, batch_size);
+    }
+
+    sm90::decode::sparse_fp8::hisparse_demand::Params kernel_params() const {
+        if (!enabled()) return {};
+        return {
+            reinterpret_cast<const uint8_t*>(host_kv->data_ptr()),
+            host_locs->data_ptr<int32_t>(),
+            device_locs->data_ptr<int64_t>(),
+            reinterpret_cast<uint64_t*>(cache_tags->data_ptr<int64_t>()),
+            decode_calls->data_ptr<int32_t>(),
+            num_real_reqs->data_ptr<int32_t>(),
+            req_pool_indices->data_ptr<int64_t>(),
+            seq_lens->data_ptr<int32_t>(),
+            mtp_committed_lens->data_ptr<int32_t>(),
+            static_cast<int>(cache_rows),
+            int64_stride_to_int(host_locs->stride(0)),
+            int64_stride_to_int(device_locs->stride(0)),
+            static_cast<int>(host_locs->size(1)),
+            int64_stride_to_int(cache_tags->stride(0)),
+            int64_stride_to_int(cache_tags->stride(1)),
+        };
+    }
+};
