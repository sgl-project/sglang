load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Transitional E2E: Bazel owns invocation and platform selection while the
# existing hardware CI image still supplies torch and native extension wheels.
# Run with:
#   bazel test --config=cuda //bazel/integration:dummy_model_e2e
sh_test(
    name = "dummy_model_e2e",
    srcs = ["run_system_python.sh"],
    args = ["$(location :dummy_model_e2e.py)"],
    data = ["dummy_model_e2e.py"],
    tags = [
        "local",
        "manual",
        "requires-cuda",
        "requires-gpu",
    ],
    target_compatible_with = ["//bazel/platforms:cuda"],
)

# Pinned real-weight smoke. The model must be prefetched into HF_HOME; the test
# resolves it offline and never downloads from inside a Bazel action.
sh_test(
    name = "qwen2_real_weight_e2e",
    srcs = ["run_system_python.sh"],
    args = ["$(location :qwen2_real_weight_e2e.py)"],
    data = ["qwen2_real_weight_e2e.py"],
    tags = [
        "local",
        "manual",
        "requires-cuda",
        "requires-gpu",
    ],
    target_compatible_with = ["//bazel/platforms:cuda"],
)

# Bazel owns the interpreter, repository sources, runtime data, and every
# third-party wheel on this CPU import/CLI path. It imports Engine without
# instantiating it; accelerator startup additionally needs platform wheels.
py_binary(
    name = "sglang_cli",
    srcs = ["sglang_cli.py"],
    deps = ["//python/sglang:runtime_sources"],
)

py_test(
    name = "runtime_import_test",
    srcs = ["runtime_import_test.py"],
    deps = ["//python/sglang:runtime_sources"],
)
