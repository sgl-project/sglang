load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python/uv:lock.bzl", uv_lock = "lock")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@runtime_import//:requirements.bzl", "requirement")
load("@wheel_repair//:requirements.bzl", wheel_repair_requirement = "requirement")
load(":main_wheel.bzl", "main_wheel")
load(":manylinux_wheel.bzl", "manylinux_wheel")
load(":pep517_wheel.bzl", "pep517_wheel")
load(":wheel_layer.bzl", "wheel_layer")

package(default_visibility = ["//visibility:public"])

exports_files([
    "wheel_repair.requirements.in",
    "wheel_repair.requirements.lock.txt",
])

uv_lock(
    name = "wheel_repair_requirements",
    srcs = ["wheel_repair.requirements.in"],
    out = "wheel_repair.requirements.lock.txt",
    args = [
        "--python-version",
        "3.12",
    ],
    tags = ["manual"],
)

sh_binary(
    name = "build_pep517_wheel",
    srcs = ["build_pep517_wheel.sh"],
)

py_binary(
    name = "build_main_wheel",
    srcs = ["build_main_wheel.py"],
    main = "build_main_wheel.py",
    python_version = "PY3",
    deps = [requirement("packaging")],
)

py_binary(
    name = "build_wheel_layer",
    srcs = ["build_wheel_layer.py"],
    main = "build_wheel_layer.py",
    python_version = "PY3",
)

# The release pipeline supplies the setuptools-scm result explicitly:
#   bazel build --define=SGLANG_WHEEL_VERSION=<version> \
#     //bazel/packaging:main_wheel
main_wheel(
    name = "main_wheel",
    srcs = ["//python/sglang:main_wheel_sources"],
    abi = "cp312",
    distribution = "sglang",
    extension_suffix = ".cpython-312-x86_64-linux-gnu.so",
    native_extensions = {
        "//python/sglang/srt/rust_extensions:_multimodal": "sglang.srt.rust_extensions._multimodal",
        "//python/sglang/srt/rust_extensions:_server": "sglang.srt.rust_extensions._server",
        "//rust/sglang-grpc:sglang_grpc_core": "sglang.srt.rust_extensions._grpc",
    },
    platform = "linux_x86_64",
    pyproject = "//python:pyproject.toml",
    python_tag = "cp312",
    readme = "//:README.md",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

py_binary(
    name = "repair_manylinux_wheel",
    srcs = ["repair_manylinux_wheel.py"],
    main = "repair_manylinux_wheel.py",
    python_version = "PY3",
    deps = [
        wheel_repair_requirement("auditwheel"),
        wheel_repair_requirement("patchelf"),
    ],
)

# This consumes :main_wheel as a single input. It never invokes PEP 517 or a
# second native build: auditwheel verifies the requested policy, then the
# wrapper checks exact tags, ELF ABI/RPATH, RECORD hashes, payload identity,
# and imports for all three extension modules.
manylinux_wheel(
    name = "main_wheel_manylinux",
    abi = "cp312",
    auditwheel_version = "6.8.1",
    extension_suffix = ".cpython-312-x86_64-linux-gnu.so",
    input_platform = "linux_x86_64",
    max_glibc = "2.18",
    native_modules = [
        "sglang.srt.rust_extensions._grpc",
        "sglang.srt.rust_extensions._multimodal",
        "sglang.srt.rust_extensions._server",
    ],
    output_platform = "manylinux_2_24_x86_64",
    patchelf_version = "0.19.1.0",
    python_tag = "cp312",
    target_compatible_with = [
        "//bazel/platforms:glibc_2_24",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    wheel = ":main_wheel",
)

wheel_layer(
    name = "main_wheel_layer",
    site_packages = "usr/local/lib/python3.12/site-packages",
    tags = ["manual"],
    wheel = ":main_wheel_manylinux",
)

# Shadow smoke artifact only. Existing Dockerfiles and release workflows remain
# authoritative; this target intentionally has no oci_push companion.
oci_image(
    name = "main_wheel_image",
    base = "@python_3_12_slim_bookworm_linux_amd64",
    entrypoint = ["/usr/local/bin/sglang-wheel-version-smoke"],
    env = {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1",
    },
    labels = {
        "org.opencontainers.image.description": "Direct Bazel SGLang wheel smoke image",
        "org.opencontainers.image.source": "https://github.com/sgl-project/sglang",
        "org.opencontainers.image.title": "SGLang Bazel wheel smoke",
    },
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tars = [":main_wheel_layer"],
    workdir = "/",
)

oci_load(
    name = "main_wheel_image_load",
    image = ":main_wheel_image",
    repo_tags = ["local/sglang-bazel-wheel:smoke"],
    tags = ["manual"],
)

# This action deliberately preserves the existing release authority instead of
# reimplementing wheel assembly. It is declared, but NOT hermetic: PEP 517 build
# isolation downloads backend requirements, and setuptools-rust consumes the
# host Cargo/Rust/C toolchains and system libraries. The implementation forces
# local, unsandboxed, non-cacheable execution and prints the same warning.
pep517_wheel(
    name = "main_wheel_pep517",
    srcs = [
        "//:release_metadata",
        "//proto/sglang/runtime/v1:main_wheel_pep517_sources",
        "//python:main_wheel_pep517_sources",
        "//rust:main_wheel_pep517_sources",
    ],
    builder = ":build_pep517_wheel",
    tags = [
        "local",
        "manual",
        "no-cache",
        "no-remote",
        "no-sandbox",
        "requires-host-python",
        "requires-network",
        "transitional-pep517",
    ],
)

py_binary(
    name = "compare_main_wheels",
    srcs = ["compare_wheels.py"],
    main = "compare_wheels.py",
    python_version = "PY3",
)
