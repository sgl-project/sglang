load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python/uv:lock.bzl", uv_lock = "lock")

package(default_visibility = ["//visibility:public"])

exports_files([
    "hf_management.requirements.in",
    "hf_management.requirements.lock.txt",
    "profiles.json",
    "runtime_import.requirements.in",
    "runtime_import.requirements.lock.txt",
    "srt_empty_bootstrap.requirements.in",
    "srt_empty_bootstrap.requirements.lock.txt",
])

uv_lock(
    name = "hf_management_requirements",
    srcs = ["hf_management.requirements.in"],
    out = "hf_management.requirements.lock.txt",
    args = [
        "--python-version",
        "3.12",
    ],
    tags = ["manual"],
)

uv_lock(
    name = "runtime_import_requirements",
    srcs = ["runtime_import.requirements.in"],
    out = "runtime_import.requirements.lock.txt",
    args = [
        "--python-version",
        "3.12",
    ],
    tags = ["manual"],
)

uv_lock(
    name = "srt_empty_bootstrap_requirements",
    srcs = ["srt_empty_bootstrap.requirements.in"],
    out = "srt_empty_bootstrap.requirements.lock.txt",
    tags = ["manual"],
)

py_test(
    name = "package_profiles_test",
    srcs = ["package_profiles_test.py"],
    data = [
        "profiles.json",
        "srt_empty_bootstrap.requirements.lock.txt",
        "//python:pyproject.toml",
        "//python:pyproject_cpu.toml",
        "//python:pyproject_npu.toml",
        "//python:pyproject_other.toml",
        "//python:pyproject_xpu.toml",
        "//test/registered/core:test_srt_empty_deps.py",
    ],
)

py_test(
    name = "environ_test",
    srcs = ["environ_test.py"],
    deps = ["//python/sglang/srt:environ"],
)

py_test(
    name = "kernel_metadata_test",
    srcs = ["kernel_metadata_test.py"],
    deps = ["//python/sglang/kernels:metadata"],
)

py_test(
    name = "hf_hub_management_test",
    srcs = ["hf_hub_management_test.py"],
    deps = ["//python/sglang/srt/utils/hf_transformers:hub"],
)

py_test(
    name = "hf_transformers_patches_test",
    srcs = ["hf_transformers_patches_test.py"],
    deps = ["//python/sglang/srt/utils:hf_transformers_patches"],
)

py_test(
    name = "weight_cache_protocol_test",
    srcs = ["weight_cache_protocol_test.py"],
    deps = ["//python/sglang/srt/weight_cache:protocol"],
)

test_suite(
    name = "torch_free_tests",
    tests = [
        ":environ_test",
        ":hf_hub_management_test",
        ":hf_transformers_patches_test",
        ":kernel_metadata_test",
        ":package_profiles_test",
        ":weight_cache_protocol_test",
    ],
)
